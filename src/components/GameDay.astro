---
// One day of games on the games page: a heading row with the day, then the games as tiles in a grid that
// fills the width it has, in tip-off order along each row. Each game is an li of the "g" class that labels
// its own figures, so no column heading is shared between games.
interface Props {
  /** The day as shown: "Sun, Oct 25". */
  heading: string;
  /** Grey context after the day, such as "NBA Finals · Game 5". */
  meta?: string;
  /** The list's accessible name. */
  label: string;
  /** The first day of the week ahead, set larger: the games a reader most likely came for. */
  lead?: boolean;
}

const { heading, meta, label, lead = false } = Astro.props;
---

<section class:list={["gday", { lead }]} aria-label={label}>
  <h3>{heading}{meta && <span class="meta"> · {meta}</span>}</h3>
  <ol class="gs"><slot /></ol>
</section>

<style>
  .gday + :global(.gday) { margin-top: 16px; }
  h3 { padding: 4px 0 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--fs-body); line-height: 20px; font-weight: 600; }
  .lead h3 { font-size: var(--fs-card); }
  .meta { color: var(--muted); font-size: var(--fs-body); font-weight: 400; }
  .gs { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--tile)), 1fr)); gap: 8px; }
  .gs :global(.g) { min-width: 0; padding: 8px 12px 10px; background: var(--raised); border-radius: 4px; }
</style>
