---
// How it works, step 5: a game's chance worked out as a sum in large figures, the home team's rating plus home
// court less the visitor's, giving the gap; under it, each side's chance on the games page's bar. The reader picks
// one of the next few games; a season with no games ahead shows its last game, as the ratings stood before it.
// Without script it shows the first game.
import ChanceBar from "../ChanceBar.astro";
import type { Abbr } from "../../lib/elo.ts";
import { ahead, before, figure, told, worked } from "../../lib/explain/matchup.ts";
import { nextDays, priced, WEEK } from "../../lib/fixtures.ts";
import { between, matchup, MINUS, pct } from "../../lib/format.ts";
import { TODAY, team, type SeasonView } from "../../lib/season.ts";
import { pairStyles } from "../../lib/tint.ts";

interface Props {
  season: SeasonView;
}

const CHOICES = 4;

const { season } = Astro.props;
const model = season.model;
const name = (a: Abbr) => team(season, a).short;
const fixtures = nextDays(model, TODAY, WEEK).flatMap((d) => d.fixtures).slice(0, CHOICES);
const last = model.results.at(-1);
const games = fixtures.map((f) => ahead(f, model));
const pairings = games.length ? games : last ? [before(last, model)] : [];
const first = fixtures[0] ?? (last && priced(last.game, last.p));
const shown = pairings[0];

const view = shown && first && (() => {
  const w = worked(shown, model.home);
  const names = { away: name(shown.away), home: name(shown.home) };
  return { w, names, tint: pairStyles(team(season, shown.away), team(season, shown.home)), homeFav: shown.p >= 0.5 };
})();

const data = {
  home: model.home,
  teams: Object.fromEntries(pairings.flatMap((p) => [p.away, p.home]).map((a) => [a, team(season, a)])),
  pairings,
};
---

{view && first && (
  <div class="matchup" data-matchup={JSON.stringify(data)}>
    {games.length > 0 && (
      <div class="games" role="group" aria-label="Games ahead">
        {games.map((p, i) => (
          <button type="button" data-pairing={i} aria-pressed={i === 0 ? "true" : "false"}>{matchup(name(p.away), name(p.home), p.neutral)}</button>
        ))}
      </div>
    )}

    <div class="sum" role="img" aria-label={told(view.w, view.names)} data-sum>
      <span class="term" style={view.tint[1]} data-tint="home">
        <span class="label"><i class="key"></i><span data-fill="home">{view.names.home}</span></span>
        <span class="fig" data-fill="home-rating">{figure(view.w.home)}</span>
      </span>
      <span class="op" data-court hidden={!view.w.court}>+</span>
      <span class="term" data-court hidden={!view.w.court}>
        <span class="label">Home court</span>
        <span class="fig" data-fill="court">{figure(view.w.court)}</span>
      </span>
      <span class="op">{MINUS}</span>
      <span class="term" style={view.tint[0]} data-tint="away">
        <span class="label"><i class="key"></i><span data-fill="away">{view.names.away}</span></span>
        <span class="fig" data-fill="away-rating">{figure(view.w.away)}</span>
      </span>
      <span class="op">=</span>
      <span class="term gap">
        <span class="label">Gap</span>
        <span class="fig" data-fill="gap">{figure(view.w.gap)}</span>
      </span>
    </div>

    <div class="tile" aria-hidden="true">
      <div class="teams">
        <span class:list={{ fav: !view.homeFav }} data-fav="away" data-fill="away">{view.names.away}</span>
        <span class:list={{ fav: view.homeFav }} data-fav="home"><span data-fill="between">{between(shown.neutral)}</span> <span data-fill="home">{view.names.home}</span></span>
      </div>
      <ChanceBar fixture={first} teams={model.data.teams} />
    </div>
    <div aria-live="polite">
      <p class="sr"><span data-fill="away">{view.names.away}</span> <span data-fill="away-chance">{pct(1 - shown.p)}</span>, <span data-fill="home">{view.names.home}</span> <span data-fill="home-chance">{pct(shown.p)}</span>.</p>
    </div>
  </div>
)}

<script>
  import type { Abbr, Team } from "../../lib/elo.ts";
  import { figure, SIDES, told, worked, type Pairing } from "../../lib/explain/matchup.ts";
  import { between, pct } from "../../lib/format.ts";
  import { pairStyles } from "../../lib/tint.ts";

  type Data = { home: number; teams: Record<Abbr, Team>; pairings: Pairing[] };

  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const root of document.querySelectorAll<HTMLElement>("[data-matchup]")) {
    const data: Data = JSON.parse(root.dataset.matchup!);
    const all = <T extends HTMLElement = HTMLElement>(selector: string) => [...root.querySelectorAll<T>(selector)];
    const one = <T extends HTMLElement = HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const chips = all<HTMLButtonElement>("[data-pairing]");
    const sum = one("[data-sum]");
    const terms = all(".term");
    const bar = one(".bar");

    function show(p: Pairing) {
      const w = worked(p, data.home);
      const names = { away: data.teams[p.away].short, home: data.teams[p.home].short };
      const tint = pairStyles(data.teams[p.away], data.teams[p.home]);
      const chance = { away: 1 - p.p, home: p.p };
      const homeFav = p.p >= 0.5;
      const text: Record<string, string> = {
        away: names.away, home: names.home, "away-rating": figure(w.away), "home-rating": figure(w.home), court: figure(w.court),
        gap: figure(w.gap), between: between(p.neutral), "away-chance": pct(chance.away), "home-chance": pct(chance.home),
      };
      terms.forEach((t, i) => {
        const fills = [...t.querySelectorAll<HTMLElement>("[data-fill]")];
        if (still || t.hidden || fills.every((el) => el.textContent === text[el.dataset.fill!])) return;
        for (const el of t.children) {
          el.animate([{ opacity: 0, transform: "translateY(0.25em)" }, { opacity: 1, transform: "none" }], { duration: 210, delay: i * 30, easing: "cubic-bezier(0.2, 0, 0, 1)", fill: "backwards" });
        }
      });
      for (const el of all("[data-fill]")) el.textContent = text[el.dataset.fill!];
      for (const el of all("[data-court]")) el.hidden = !w.court;
      sum.setAttribute("aria-label", told(w, names));
      SIDES.forEach((side, i) => {
        one(`[data-tint="${side}"]`).setAttribute("style", tint[i]);
        one(`[data-fav="${side}"]`).classList.toggle("fav", (side === "home") === homeFav);
      });
      for (const c of chips) c.setAttribute("aria-pressed", String(data.pairings[Number(c.dataset.pairing)] === p));

      all(".num").forEach((n, i) => {
        n.textContent = pct(chance[SIDES[i]]);
        n.classList.toggle("fav", (i === 1) === homeFav);
      });
      bar.style.gridTemplateColumns = `${chance.away}fr ${chance.home}fr`;
      all(".bar i").forEach((s, i) => {
        s.setAttribute("style", tint[i]);
        s.dataset.team = p[SIDES[i]];
      });
    }

    for (const c of chips) c.addEventListener("click", () => show(data.pairings[Number(c.dataset.pairing)]));
  }
</script>

<style>
  .matchup { --ease: cubic-bezier(0.2, 0, 0, 1); max-width: 760px; container-type: inline-size; }

  /* The games to pick from, the chosen one in ink over the accent line the site marks a selection with. */
  .games { display: flex; flex-wrap: wrap; column-gap: 20px; margin-bottom: 20px; }
  .games button {
    height: var(--control-h); color: var(--muted); font-weight: 500; white-space: nowrap;
    text-decoration-line: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: 6px;
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }
  .games button:hover { color: var(--text); }
  .games button[aria-pressed="true"] { color: var(--text); text-decoration-color: var(--accent); }
  @media (pointer: coarse) {
    .games button { min-height: 40px; }
  }

  /* The sum, read as arithmetic: on a narrow card a column like a receipt, the operators down its left edge, each
     term's name beside its figure and the figures right-aligned; on a wide one a single line, the names in a row
     above the figures. Either way the figures share a baseline with the operators, and the gap is the largest. */
  .sum {
    --fig: 36px; --total: 44px;
    display: grid; grid-template-columns: auto auto auto; justify-content: start; align-items: baseline; gap: 8px 12px;
    margin-bottom: 24px; line-height: 1; font-variant-numeric: tabular-nums;
  }
  .term { display: contents; }
  .term[hidden] { display: none; }
  .op { grid-column: 1; font-size: var(--fig); color: var(--muted); }
  .label { grid-column: 2; color: var(--muted); white-space: nowrap; }
  .fig { grid-column: 3; justify-self: end; font-size: var(--fig); font-weight: 600; letter-spacing: -0.02em; color: var(--text); }
  .gap .fig { font-size: var(--total); color: var(--accent); }
  /* Each team's name is keyed to its part of the bar below by a swatch of the same mark. */
  .key { display: inline-block; width: 12px; height: 6px; margin-right: 8px; border-radius: 3px; vertical-align: 1px; background: var(--tint); }

  @container (min-width: 600px) {
    .sum { --fig: 44px; --total: 56px; grid: auto auto / auto-flow auto; column-gap: 16px; font-variant-numeric: normal; }
    .label { grid-area: 1 / auto; }
    .op, .fig { grid-area: 2 / auto; justify-self: start; }
  }

  /* The answer as the games page shows a game: the two teams, the favourite in ink, over their chances. The bar
     moves to each game's split. */
  .tile { padding: 8px 12px 10px; background: var(--raised); border-radius: 4px; }
  .tile :global(.bar) { transition: grid-template-columns 300ms var(--ease); }
  .teams { display: flex; align-items: center; justify-content: space-between; gap: 12px; line-height: 22px; color: var(--muted); }
  .teams > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .teams .fav { color: var(--text); font-weight: 500; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
