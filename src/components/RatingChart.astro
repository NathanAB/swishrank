---
// Every team's daily rating from the 1500 they all start at, with the start of the playoffs marked once they
// begin. Pointing anywhere on the plot previews the nearest line (lib/pick.ts), shows that day with a thin
// line and a box with the team's rating and rank (lib/readout.ts), and a click opens the team's page. The end
// of every line is labelled with its abbreviation in two staggered columns with short leaders, so labels
// never collide. Given a `team`, a team's own page, the same lines are drawn with only that team's in its own
// colour and labelled, by its name, and pointing at the plot reads out that team alone. Otherwise each line
// and leader carries a faint tint of its team's colour (lib/tint.ts), full strength while the team is
// previewed. The plot stretches with the card, the whole season at any width; the tick lane and the label
// lane keep a fixed size, and the height is fixed too, so the label layout worked out here holds at every
// width.
import { dateTicks, playoffsMark, ratingTicks } from "../lib/chart.ts";
import { START, type Abbr } from "../lib/elo.ts";
import { shortDay, weekdayDay } from "../lib/format.ts";
import { scaleAttr } from "../lib/readout.ts";
import { href } from "../lib/routes.ts";
import type { SeasonView } from "../lib/season.ts";
import { tintStyles } from "../lib/tint.ts";

interface Props {
  season: SeasonView;
  /** The teams to draw, in rating order; leave it out for the whole league. The scale is always the league's. */
  teams?: readonly Abbr[];
  /** The page's own team, on a team's page: its line alone is in its own colour and labelled. */
  team?: Abbr;
  /** Plot height in px, the same at every width. */
  height?: number;
}

const { season, team, teams = season.model.order, height: H = 300 } = Astro.props;
const m = season.model;
const ser = m.series;
const n = ser.length;

const all = ser.flatMap((d) => m.abbrs.map((a) => d.r[a]));
const { lo, hi, ticks } = ratingTicks(Math.min(START, ...all), Math.max(START, ...all));
const PAD = 8;
const y = (v: number) => PAD + ((H - 2 * PAD) * (hi - v)) / (hi - lo);
const X = 1000; // the plot's viewBox width, stretched to the card
const x = (i: number) => (n <= 1 ? 0 : (i / (n - 1)) * X);
const pct = (i: number) => `${((x(i) / X) * 100).toFixed(2)}%`;
const points = (a: Abbr) => ser.map((d, i) => `${x(i).toFixed(1)},${y(Math.round(d.r[a])).toFixed(2)}`).join(" ");
const days = JSON.stringify(ser.map((d) => weekdayDay(d.day)));
const tint = tintStyles(m.data.teams);
const drawOrder = [...teams].reverse().sort((p, q) => Number(p === team) - Number(q === team));

const marker = playoffsMark(m);

// The label lane: two columns, so neighbours in the order sit half a label apart. Each cluster of labels
// that would overlap is spread around its mean and kept inside the plot's height.
// A 12px capital is about 8px wide, so a column is the longest abbreviation plus 8px of air; a lone name
// takes about 7px a letter.
const text = (a: Abbr) => (team ? m.data.teams[a].short : a);
const PITCH = 6, GAP = 22, COL = 8 + 8 * Math.max(...m.abbrs.map((a) => a.length));
const LANE = team ? GAP + 4 + 7 * text(team).length : GAP + 2 * COL;
const DAY_LABEL = 40, TICK_LANE = 40;
const narrowestPlot = (screen: number, pad: number, cardPad: number) => screen - 2 * pad - 2 * cardPad - TICK_LANE - LANE;
const xDays = ser.map((d) => d.day);
const xLabels = [
  { phone: false, list: dateTicks(xDays, DAY_LABEL / narrowestPlot(641, 24, 20)) },
  { phone: true, list: dateTicks(xDays, DAY_LABEL / narrowestPlot(360, 16, 16)) },
];
const last = ser[n - 1];
const labels = teams.filter((a) => !team || a === team).map((a) => ({ a, y: last ? y(last.r[a]) : 0, ly: 0 }));
type Cluster = { list: typeof labels; sum: number; top: number; bot: number };
const place = (c: Cluster) => {
  const span = (c.list.length - 1) * PITCH;
  c.top = Math.min(Math.max(c.sum / c.list.length - span / 2, 6), H - 6 - span);
  c.bot = c.top + span;
};
const clusters: Cluster[] = labels.map((l) => ({ list: [l], sum: l.y, top: 0, bot: 0 }));
clusters.forEach(place);
for (let merged = true; merged; ) {
  merged = false;
  for (let i = 0; i < clusters.length - 1; i++) {
    if (clusters[i].bot + PITCH > clusters[i + 1].top + 0.01) {
      const c: Cluster = { list: [...clusters[i].list, ...clusters[i + 1].list], sum: clusters[i].sum + clusters[i + 1].sum, top: 0, bot: 0 };
      place(c);
      clusters.splice(i, 2, c);
      merged = true;
      break;
    }
  }
}
for (const c of clusters) c.list.forEach((l, k) => (l.ly = c.top + k * PITCH));

const label = `Daily rating of ${teams.length === m.abbrs.length ? "all " : ""}${teams.length} teams${n ? `, ${shortDay(ser[0].day)} to ${shortDay(ser[n - 1].day)}` : ""}, each starting at ${START}`;
---

{n < 2 ? (
  <p class="empty">No games yet.</p>
) : (
  <div class="chart">
    <div class:list={["rc", { tinted: !team }]} role="img" aria-label={label} style={`--h: ${H}px; --ticks: ${TICK_LANE}px; --lane: ${LANE}px`}>
      {marker && <span class="mark-label" style={`left: ${pct(marker.i)}`}>{marker.label}</span>}
      <svg class="ticks" width={TICK_LANE} height={H} viewBox={`0 0 ${TICK_LANE} ${H}`}>
        {ticks.map((t) => <text x="32" y={y(t) + 4} text-anchor="end">{t}</text>)}
      </svg>
      <svg
        class="plot"
        data-plot={team ? undefined : ""}
        data-chart
        data-own={team}
        data-scale={scaleAttr({ hi, yHi: y(hi), lo, yLo: y(lo) })}
        data-days={days}
        viewBox={`0 0 ${X} ${H}`}
        preserveAspectRatio="none"
        height={H}
      >
        {ticks.map((t) => <path class="grid" d={`M0,${y(t)}H${X}`} />)}
        {marker && <path class="marker" d={`M${x(marker.i).toFixed(1)},0V${H}`} />}
        <path class="cross" data-cross d={`M0,0V${H}`} />
        <g>
          {drawOrder.map((a) => (
            <polyline
              class:list={["line", { own: a === team }]}
              data-team={a}
              data-name={m.data.teams[a].short}
              data-href={team ? undefined : href({ kind: "team", season, abbr: a })}
              data-raise
              style={tint[a]}
              points={points(a)}
            />
          ))}
        </g>
      </svg>
      <svg class="lane" width={LANE} height={H} viewBox={`0 0 ${LANE} ${H}`}>
        {labels.map((l, k) => {
          const lx = GAP + (k % 2) * COL;
          return (
            <g>
              <path class:list={["leader", { own: l.a === team }]} data-team={l.a} style={tint[l.a]} d={`M2,${l.y.toFixed(1)}L6,${l.y.toFixed(1)}L${GAP - 5},${l.ly.toFixed(1)}L${lx - 3},${l.ly.toFixed(1)}`} />
              <text class:list={["lab", { own: l.a === team }]} data-team={l.a} x={lx} y={(l.ly + 4).toFixed(1)}>
                {text(l.a)}
              </text>
            </g>
          );
        })}
        {labels.map((l) => <circle class:list={["end", { own: l.a === team }]} data-team={l.a} style={tint[l.a]} cx="0" cy={l.y.toFixed(1)} r="4" />)}
      </svg>
      {xLabels.map((set) => (
        <div class:list={["xs", { phone: set.phone }]}>
          {set.list.map((l) => (
            <span class:list={{ first: l.i === 0, last: l.i === n - 1 }} style={`left: ${pct(l.i)}`}>{l.text}</span>
          ))}
        </div>
      ))}
      <div class="tip" data-tip hidden></div>
    </div>
  </div>
)}

<style>
  .empty { padding: 8px 0 12px; color: var(--muted); }

  .rc { position: relative; display: grid; grid-template-columns: var(--ticks) minmax(0, 1fr) var(--lane); grid-template-rows: auto var(--h) 20px; }
  .mark-label {
    grid-row: 1; grid-column: 2; position: relative; justify-self: start; transform: translateX(calc(-100% - 4px));
    font-size: 11px; line-height: 16px; color: var(--muted); white-space: nowrap;
  }
  .ticks { grid-row: 2; grid-column: 1; overflow: visible; }
  .plot { grid-row: 2; grid-column: 2; width: 100%; overflow: visible; }
  .lane { grid-row: 2; grid-column: 3; overflow: visible; }
  .xs { grid-row: 3; grid-column: 2; position: relative; }
  .xs span { position: absolute; top: 4px; transform: translateX(-50%); font-size: var(--fs-small); line-height: 16px; color: var(--muted); white-space: nowrap; }
  .xs .first { transform: none; }
  .xs .last { transform: translateX(-100%); }
  .xs.phone { display: none; }
  @media (max-width: 640px) {
    .xs { display: none; }
    .xs.phone { display: block; }
  }

  text { font: 12px var(--font); font-variant-numeric: tabular-nums; fill: var(--muted); }
  .plot path, .plot polyline { fill: none; vector-effect: non-scaling-stroke; }
  .grid { stroke: var(--grid); stroke-width: 1; }
  .marker { stroke: var(--muted); stroke-width: 1; }
  .line { stroke: var(--line-other); stroke-opacity: 0.55; stroke-width: 1; stroke-linejoin: round; }
  .line.hov { stroke: var(--text); stroke-opacity: 1; stroke-width: 1.5; }
  .line.own { stroke: var(--tint); stroke-opacity: 1; stroke-width: 2; }
  .leader { fill: none; stroke: var(--line-other); stroke-opacity: 0.6; stroke-width: 1; }
  .leader.own { stroke: var(--tint); stroke-opacity: 1; }
  .tinted :is(.line, .leader) { stroke: var(--tint-rest); stroke-opacity: 1; }
  .tinted .line.hov { stroke: var(--tint); stroke-opacity: 1; stroke-width: 1.75; }
  .tinted .leader.hov { stroke: var(--tint); }
  .tinted:has(.hov) :is(.line, .leader):not(.hov) { opacity: 0.4; }
  .plot[data-plot]:has(.line.hov) { cursor: pointer; }
  .lab.hov { fill: var(--text); }
  .lab.own { fill: var(--text); font-weight: 600; }
  .end { display: none; fill: var(--tint); stroke: var(--surface); stroke-width: 2; }
  .end.own { display: inline; }
</style>
