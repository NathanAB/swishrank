---
// A season's daily ratings from the 1000 every team starts at, on the scale every drawing of a season shares
// (lib/chart.ts seasonPlot), with the regular season's end marked once the postseason has a game, and each line
// dotted past the end of its team's run. The plot stretches with the card, the whole season at any width; the
// tick lane and the label lane keep a fixed size, and the height is fixed too, so the label layout worked out
// here holds at every width.
//
// The whole league (the home page): every line carries a faint tint of its team's colour (lib/tint.ts), full
// strength while the team is previewed, and is labelled at its end with its abbreviation, in two staggered
// columns with short leaders so labels never collide. Pointing anywhere on the plot previews the nearest line
// (lib/pick.ts), shows that day with a thin line and a box with the team's rating and rank (lib/readout.ts),
// and a click opens the team's page.
//
// With `focus`, the teams a page is about (a team's own page, a game's two): only their lines are drawn on the
// page, in colour and labelled by name (by abbreviation on a phone, so the lines keep the width), in front of
// every other team's line in grey from the season's league-lines file, and the readout names their league rank. One team is read out wherever the pointer is;
// of two, the nearer, and a click opens its page. A `mark`, such as a game's day, takes the season end's place.
import Empty from "./Empty.astro";
import { dateTicks, PLOT, runAndTrail, seasonEndMark, seasonPlot } from "../lib/chart.ts";
import { START, type Abbr } from "../lib/elo.ts";
import { shortDay } from "../lib/format.ts";
import { scaleAttr } from "../lib/readout.ts";
import { href, withBase } from "../lib/routes.ts";
import type { SeasonView } from "../lib/season.ts";
import { tintStyles } from "../lib/tint.ts";

interface Props {
  season: SeasonView;
  /** The whole-league chart's teams, in rating order; leave it out for all of them. */
  teams?: readonly Abbr[];
  /** The teams a page is about: only their lines are in colour, labelled by name and read out. */
  focus?: readonly Abbr[];
  /** Style attributes that set --tint for focus teams, in place of their line colours. */
  paint?: Record<Abbr, string>;
  /** A day to mark in place of the regular season's end, with its label. */
  mark?: { day: string; label: string };
  /** The whole-league chart's plot height in px. A chart with focus teams is PLOT.h, its league-lines file's height. */
  height?: number;
}

const { season, focus = [], paint, mark, height } = Astro.props;
const m = season.model;
const focused = focus.length > 0;
const teams = focused ? focus : (Astro.props.teams ?? m.order);
const H = focused ? PLOT.h : (height ?? PLOT.h);
const plot = seasonPlot(m, { h: H });
const { n, lo, hi, ticks, x, y } = plot;
const ser = m.series;
const X = PLOT.w;
const pct = (i: number) => `${((x(i) / X) * 100).toFixed(2)}%`;
const split = runAndTrail(m);
const lines = Object.fromEntries(teams.map((a) => [a, split(a, plot.pts(a))]));
const tint = { ...tintStyles(m.data.teams), ...paint };
const drawOrder = [...teams].reverse();
const own = focus.length === 1 ? focus[0] : undefined;

const marked = mark ? ser.findIndex((d) => d.day === mark.day) : -1;
const marker = mark ? (marked >= 0 ? { i: marked, label: mark.label } : null) : seasonEndMark(m);

// The label lane. The whole league's labels sit in two columns, so neighbours in the order sit half a label
// apart; a focus team's name gets a column of its own. Each cluster of labels that would overlap is spread
// around its mean and kept inside the plot's height.
// A 12px capital is about 8px wide, so a column is the longest abbreviation plus 8px of air; a name takes
// about 7px a letter.
const PITCH = focused ? 14 : 6, GAP = 22, COL = 8 + 8 * Math.max(...m.abbrs.map((a) => a.length));
const LANE = focused ? GAP + 4 + 7 * Math.max(...focus.map((a) => m.data.teams[a].short.length)) : GAP + 2 * COL;
const LANE_PHONE = focused ? GAP + 4 + 8 * Math.max(...focus.map((a) => a.length)) : LANE;
const DAY_LABEL = 40, TICK_LANE = 40;
const narrowestPlot = (screen: number, pad: number, cardPad: number, lane: number) => screen - 2 * pad - 2 * cardPad - TICK_LANE - lane;
const xDays = ser.map((d) => d.day);
const xLabels = [
  { phone: false, list: dateTicks(xDays, DAY_LABEL / narrowestPlot(641, 24, 20, LANE)) },
  { phone: true, list: dateTicks(xDays, DAY_LABEL / narrowestPlot(360, 16, 16, LANE_PHONE)) },
];
const last = ser[n - 1];
const labels = teams.map((a) => ({ a, y: last ? y(last.r[a]) : 0, ly: 0 }));
type Cluster = { list: typeof labels; sum: number; top: number; bot: number };
const place = (c: Cluster) => {
  const span = (c.list.length - 1) * PITCH;
  c.top = Math.min(Math.max(c.sum / c.list.length - span / 2, 6), H - 6 - span);
  c.bot = c.top + span;
};
const clusters: Cluster[] = [...labels].sort((p, q) => p.y - q.y).map((l) => ({ list: [l], sum: l.y, top: 0, bot: 0 }));
clusters.forEach(place);
for (let merged = true; merged; ) {
  merged = false;
  for (let i = 0; i < clusters.length - 1; i++) {
    if (clusters[i].bot + PITCH > clusters[i + 1].top + 0.01) {
      const c: Cluster = { list: [...clusters[i].list, ...clusters[i + 1].list], sum: clusters[i].sum + clusters[i + 1].sum, top: 0, bot: 0 };
      place(c);
      clusters.splice(i, 2, c);
      merged = true;
      break;
    }
  }
}
for (const c of clusters) c.list.forEach((l, k) => (l.ly = c.top + k * PITCH));

const whose = focused
  ? `the ${focus.map((a) => m.data.teams[a].short).join(" and ")} among all ${m.abbrs.length} teams`
  : `${teams.length === m.abbrs.length ? "all " : ""}${teams.length} teams`;
const label = `Daily rating of ${whose}${n ? `, ${shortDay(ser[0].day)} to ${shortDay(ser[n - 1].day)}` : ""}, each starting at ${START}`;
---

{n < 2 ? (
  <Empty />
) : (
  <div class="chart">
    <div class:list={["rc", focused ? "focus" : "tinted"]} role="img" aria-label={label} style={`--h: ${H}px; --ticks: ${TICK_LANE}px; --lane: ${LANE}px; --lane-phone: ${LANE_PHONE}px`}>
      {marker && <span class="mark-label" style={`left: ${pct(marker.i)}`}>{marker.label}</span>}
      <svg class="ticks" width={TICK_LANE} height={H} viewBox={`0 0 ${TICK_LANE} ${H}`}>
        {ticks.map((t) => <text x="32" y={y(t) + 4} text-anchor="end">{t}</text>)}
      </svg>
      <svg
        class="plot"
        data-plot={own ? undefined : ""}
        data-chart
        data-own={own}
        data-scale={scaleAttr({ hi, yHi: y(hi), lo, yLo: y(lo) })}
        data-from={ser[0]?.day}
        viewBox={`0 0 ${X} ${H}`}
        preserveAspectRatio="none"
        height={H}
      >
        {ticks.map((t) => <path class="grid" d={`M0,${y(t)}H${X}`} />)}
        {marker && <path class="marker" d={`M${x(marker.i).toFixed(1)},0V${H}`} />}
        {focused && <use class="league" href={withBase(`/lines/${season.id}.svg?v=${plot.version()}#lines`)} />}
        <path class="cross" data-cross d={`M0,0V${H}`} />
        <g>
          {drawOrder.map((a) => (
            <polyline
              class="line"
              data-team={a}
              data-name={m.data.teams[a].short}
              data-href={own ? undefined : href({ kind: "team", season, abbr: a })}
              data-ranks={focused ? plot.ranks(a) : undefined}
              data-raise
              style={tint[a]}
              points={lines[a].run}
            />
          ))}
          {drawOrder.map((a) => lines[a].trail && <polyline class="trail" data-team={a} data-trail data-raise style={tint[a]} points={lines[a].trail} />)}
        </g>
      </svg>
      <svg class="lane" height={H}>
        {labels.map((l, k) => {
          const lx = focused ? GAP : GAP + (k % 2) * COL;
          return (
            <g data-team={l.a} data-preview={focused ? undefined : ""}>
              <path class="leader" data-team={l.a} style={tint[l.a]} d={`M2,${l.y.toFixed(1)}L6,${l.y.toFixed(1)}L${GAP - 5},${l.ly.toFixed(1)}L${lx - 3},${l.ly.toFixed(1)}`} />
              <text class="lab" data-team={l.a} x={lx} y={(l.ly + 4).toFixed(1)}>
                {focused ? <Fragment><tspan class="name">{m.data.teams[l.a].short}</tspan><tspan class="ab">{l.a}</tspan></Fragment> : l.a}
              </text>
            </g>
          );
        })}
        {labels.map((l) => <circle class="end" data-team={l.a} style={tint[l.a]} cx="0" cy={l.y.toFixed(1)} r="4" />)}
      </svg>
      {xLabels.map((set) => (
        <div class:list={["xs", { phone: set.phone }]}>
          {set.list.map((l) => (
            <span class:list={{ first: l.i === 0, last: l.i === n - 1 }} style={`left: ${pct(l.i)}`}>{l.text}</span>
          ))}
        </div>
      ))}
      <div class="tip" data-tip hidden></div>
    </div>
  </div>
)}

<style>
  .rc { position: relative; display: grid; grid-template-columns: var(--ticks) minmax(0, 1fr) var(--lane); grid-template-rows: auto var(--h) 20px; }
  .mark-label {
    grid-row: 1; grid-column: 2; position: relative; justify-self: start; transform: translateX(calc(-100% - 4px));
    font-size: 11px; line-height: 16px; color: var(--muted); white-space: nowrap;
  }
  .ticks { grid-row: 2; grid-column: 1; overflow: visible; }
  .plot { grid-row: 2; grid-column: 2; width: 100%; overflow: visible; }
  .lane { grid-row: 2; grid-column: 3; width: 100%; overflow: visible; }
  .xs { grid-row: 3; grid-column: 2; position: relative; }
  .xs span { position: absolute; top: 4px; transform: translateX(-50%); font-size: var(--fs-small); line-height: 16px; color: var(--muted); white-space: nowrap; }
  .xs .first { transform: none; }
  .xs .last { transform: translateX(-100%); }
  .xs.phone { display: none; }
  .ab { display: none; }
  @media (max-width: 640px) {
    .xs { display: none; }
    .xs.phone { display: block; }
    .rc { grid-template-columns: var(--ticks) minmax(0, 1fr) var(--lane-phone); }
    .name { display: none; }
    .ab { display: inline; }
  }

  text { font: 12px var(--font); font-variant-numeric: tabular-nums; fill: var(--muted); }
  .focus :is(.line, .trail) { stroke: var(--tint); stroke-width: 2.5; }
  .focus :is(.line, .trail).hov { stroke-width: 3.5; }
  .league { color: var(--line-other); opacity: var(--line-faded); }
  .leader { fill: none; stroke: var(--line-other); stroke-width: 1.5; stroke-dasharray: var(--line-dash); stroke-linecap: round; }
  .focus .leader { stroke: var(--tint); }
  .tinted:has(.hov) :is(.line, .trail, .leader):not(.hov) { opacity: var(--line-dim); }
  .lab.hov { fill: var(--text); }
  .focus .lab { fill: var(--text); font-weight: 600; }
  .end { display: none; fill: var(--tint); stroke: var(--surface); stroke-width: 2; }
  .focus .end { display: inline; }
</style>
