---
// Every team's daily rating from the 1500 they all start at, with the start of the playoffs marked once they
// begin. The picked team is drawn in the accent and named in the legend, the name linking to its page; a
// reader picks another by pointing anywhere on the plot, which picks the nearest line (lib/pick.ts), or with
// the team menu in the legend. The end of every line is labelled with its abbreviation in two staggered
// columns with short leaders, so labels never collide. `single` draws the same lines with only the picked team
// labelled, and no legend or picking. The plot stretches with the card; the tick lane and the label lane keep
// a fixed size, and the height is fixed too, so the label layout worked out here holds at every width. Given a
// narrowest width per day, a long season scrolls sideways inside the chart instead of squeezing its days
// together.
import { dateTicks, playoffsMark } from "../lib/chart.ts";
import { START, type Abbr } from "../lib/elo.ts";
import { shortDay } from "../lib/format.ts";
import { href } from "../lib/routes.ts";
import type { SeasonView } from "../lib/season.ts";

interface Props {
  season: SeasonView;
  /** The team drawn in the accent on load. */
  selected: Abbr;
  /** Plot height in px, the same at every width. */
  height?: number;
  /** Label only the selected team's line, by its name, with no legend and no picking: a team's own page. */
  single?: boolean;
  /**
   * The plot's narrowest width per day in px. Below it the chart scrolls sideways inside itself, opening on
   * the latest days, with the rating ticks held at its left edge. Leave it out to fit the plot to any width.
   */
  minDayWidth?: number;
}

const { season, selected, height: H = 300, single = false, minDayWidth = 0 } = Astro.props;
const m = season.model;
const ser = m.series;
const n = ser.length;

// 3 to 5 round ticks that include 1500, with the top tick above the highest point.
function scale(min: number, max: number) {
  for (const step of [25, 50, 100, 150, 200, 250, 300, 500]) {
    const lo = START - Math.ceil((START - min) / step) * step;
    let hi = START + Math.ceil((max - START) / step) * step;
    if (hi <= max) hi += step;
    const ticks: number[] = [];
    for (let v = lo; v <= hi; v += step) ticks.push(v);
    if (ticks.length <= 5 || step === 500) return { lo, hi, ticks };
  }
  throw new Error("unreachable: the last step always returns");
}

const all = ser.flatMap((d) => m.abbrs.map((a) => d.r[a]));
const { lo, hi, ticks } = scale(Math.min(START, ...all), Math.max(START, ...all));
const PAD = 8;
const y = (v: number) => PAD + ((H - 2 * PAD) * (hi - v)) / (hi - lo);
const X = 1000; // the plot's viewBox width, stretched to the card
const x = (i: number) => (n <= 1 ? 0 : (i / (n - 1)) * X);
const pct = (i: number) => `${((x(i) / X) * 100).toFixed(2)}%`;
const points = (a: Abbr) => ser.map((d, i) => `${x(i).toFixed(1)},${y(d.r[a]).toFixed(1)}`).join(" ");
const drawOrder = [...m.order].reverse().sort((p, q) => Number(p === selected) - Number(q === selected));

const xLabels = dateTicks(ser.map((d) => d.day));
const marker = playoffsMark(m);

// The label lane: two columns, so neighbours in the order sit half a label apart. Each cluster of labels
// that would overlap is spread around its mean and kept inside the plot's height.
// A 12px capital is about 8px wide, so a column is the longest abbreviation plus 8px of air; a lone name
// takes about 7px a letter.
const text = (a: Abbr) => (single ? m.data.teams[a].short : a);
const PITCH = 6, GAP = 22, COL = 8 + 8 * Math.max(...m.abbrs.map((a) => a.length));
const LANE = single ? GAP + 4 + 7 * text(selected).length : GAP + 2 * COL;
const last = ser[n - 1];
const labels = m.order.filter((a) => !single || a === selected).map((a) => ({ a, y: last ? y(last.r[a]) : 0, ly: 0 }));
type Cluster = { list: typeof labels; sum: number; top: number; bot: number };
const place = (c: Cluster) => {
  const span = (c.list.length - 1) * PITCH;
  c.top = Math.min(Math.max(c.sum / c.list.length - span / 2, 6), H - 6 - span);
  c.bot = c.top + span;
};
const clusters: Cluster[] = labels.map((l) => ({ list: [l], sum: l.y, top: 0, bot: 0 }));
clusters.forEach(place);
for (let merged = true; merged; ) {
  merged = false;
  for (let i = 0; i < clusters.length - 1; i++) {
    if (clusters[i].bot + PITCH > clusters[i + 1].top + 0.01) {
      const c: Cluster = { list: [...clusters[i].list, ...clusters[i + 1].list], sum: clusters[i].sum + clusters[i + 1].sum, top: 0, bot: 0 };
      place(c);
      clusters.splice(i, 2, c);
      merged = true;
      break;
    }
  }
}
for (const c of clusters) c.list.forEach((l, k) => (l.ly = c.top + k * PITCH));

const label = `Daily rating of all ${m.abbrs.length} teams${n ? `, ${shortDay(ser[0].day)} to ${shortDay(ser[n - 1].day)}` : ""}, each starting at ${START}`;
const scroll = minDayWidth > 0;
---

{n < 2 ? (
  <p class="empty">No games yet.</p>
) : (
  <div class="chart">
    {!single && (
      <p class="legend" aria-live="polite">
        {m.order.map((a) => (
          <span class:list={["key", { sel: a === selected }]} data-team={a}>
            <a class="nm" href={href({ kind: "team", season, abbr: a })}>{m.data.teams[a].name}</a>
          </span>
        ))}
        <select class="pick" aria-label="Team shown in the chart" data-pick-select>
          {m.order.map((a) => <option value={a} selected={a === selected}>{m.rank[a]}. {m.data.teams[a].short}</option>)}
        </select>
      </p>
    )}
    <div
      class:list={["rc", { scroll }]}
      role="img"
      aria-label={label}
      tabindex={scroll ? "0" : undefined}
      data-scroll-end={scroll ? "" : undefined}
      style={`--h: ${H}px; --lane: ${LANE}px${scroll ? `; --plot-min: ${(n - 1) * minDayWidth}px` : ""}`}
    >
      {marker && <span class="mark-label" style={`left: ${pct(marker.i)}`}>{marker.label}</span>}
      <svg class="ticks" width="40" height={H} viewBox={`0 0 40 ${H}`}>
        {ticks.map((t) => <text class:list={{ ref: t === START }} x="32" y={y(t) + 4} text-anchor="end">{t}</text>)}
      </svg>
      <svg class="plot" data-plot={single ? undefined : ""} viewBox={`0 0 ${X} ${H}`} preserveAspectRatio="none" height={H}>
        {ticks.map((t) => <path class:list={["grid", { ref: t === START }]} d={`M0,${y(t)}H${X}`} />)}
        {marker && <path class="marker" d={`M${x(marker.i).toFixed(1)},0V${H}`} />}
        <g>
          {drawOrder.map((a) => (
            <polyline class:list={["line", { sel: a === selected }]} data-team={a} data-raise points={points(a)} />
          ))}
        </g>
      </svg>
      <svg class="lane" width={LANE} height={H} viewBox={`0 0 ${LANE} ${H}`}>
        {labels.map((l, k) => {
          const lx = GAP + (k % 2) * COL;
          return (
            <g>
              <path class:list={["leader", { sel: l.a === selected }]} data-team={l.a} d={`M2,${l.y.toFixed(1)}L6,${l.y.toFixed(1)}L${GAP - 5},${l.ly.toFixed(1)}L${lx - 3},${l.ly.toFixed(1)}`} />
              <text class:list={["lab", { sel: l.a === selected }]} data-team={l.a} x={lx} y={(l.ly + 4).toFixed(1)}>
                {text(l.a)}
              </text>
            </g>
          );
        })}
        {labels.map((l) => <circle class:list={["end", { sel: l.a === selected }]} data-team={l.a} cx="0" cy={l.y.toFixed(1)} r="4" />)}
      </svg>
      <div class="xs">
        {xLabels.map((l) => (
          <span class:list={{ first: l.i === 0, last: l.i === n - 1 }} style={`left: ${pct(l.i)}`}>{l.text}</span>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  for (const el of document.querySelectorAll("[data-scroll-end]")) el.scrollLeft = el.scrollWidth;
</script>

<style>
  .empty { padding: 8px 0 12px; color: var(--muted); }
  .legend { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin-bottom: 8px; color: var(--muted); }
  .key { display: none; align-items: baseline; gap: 8px; }
  .key.sel { display: inline-flex; }
  .key::before { content: ""; width: 14px; height: 2px; align-self: center; background: var(--line-other); }
  .key.sel::before { background: var(--accent); }
  .key .nm { color: var(--text); font-weight: 600; }
  .pick { margin-left: auto; align-self: center; }
  .key .nm:hover { text-decoration: underline; text-underline-offset: 3px; }

  .rc { display: grid; grid-template-columns: 40px minmax(var(--plot-min, 0px), 1fr) var(--lane); grid-template-rows: auto var(--h) 20px; }
  /* Scrolling, the tick lane stays at the left edge over a cover down to the dates, so the lines and the
     dates pass under it. */
  .rc.scroll { overflow: auto hidden; }
  .rc.scroll::before { content: ""; grid-area: 2 / 1 / 4 / 2; position: sticky; left: 0; z-index: 1; background: var(--surface); }
  .rc.scroll .ticks { position: sticky; left: 0; z-index: 2; }
  .mark-label {
    grid-row: 1; grid-column: 2; position: relative; justify-self: start; transform: translateX(calc(-100% - 4px));
    font-size: 11px; line-height: 16px; color: var(--muted); white-space: nowrap;
  }
  .ticks { grid-row: 2; grid-column: 1; overflow: visible; }
  .plot { grid-row: 2; grid-column: 2; width: 100%; overflow: visible; }
  .plot[data-plot] { cursor: pointer; }
  .lane { grid-row: 2; grid-column: 3; overflow: visible; }
  .xs { grid-row: 3; grid-column: 2; position: relative; }
  .xs span { position: absolute; top: 4px; transform: translateX(-50%); font-size: var(--fs-small); line-height: 16px; color: var(--muted); white-space: nowrap; }
  .xs .first { transform: none; }
  .xs .last { transform: translateX(-100%); }

  text { font: 12px var(--font); font-variant-numeric: tabular-nums; fill: var(--muted); }
  .ticks .ref { fill: var(--text); }
  .plot path, .plot polyline { fill: none; vector-effect: non-scaling-stroke; }
  .grid { stroke: var(--grid); stroke-width: 1; }
  .grid.ref { stroke: var(--muted); stroke-opacity: 0.7; stroke-dasharray: 3 3; }
  .marker { stroke: var(--muted); stroke-width: 1; }
  .line { stroke: var(--line-other); stroke-opacity: 0.55; stroke-width: 1; stroke-linejoin: round; }
  .line.hov { stroke: var(--text); stroke-opacity: 1; stroke-width: 1.5; }
  .line.sel { stroke: var(--accent); stroke-opacity: 1; stroke-width: 2; }
  .leader { fill: none; stroke: var(--line-other); stroke-opacity: 0.6; stroke-width: 1; }
  .leader.sel { stroke: var(--accent); stroke-opacity: 1; }
  .lab.hov { fill: var(--text); }
  .lab.sel { fill: var(--text); font-weight: 600; }
  /* The dot overhangs the plot's last day, so it lets the pointer through to pick there. */
  .end { display: none; fill: var(--accent); stroke: var(--surface); stroke-width: 2; pointer-events: none; }
  .end.sel { display: inline; }
</style>
