---
// A team's players heatmap (src/lib/heatmap.ts): a tile per player as big as his minutes, drawn in percentages of its
// canvas, with labels and gaps in container units against the canvas's own width, so a layout scales with its card
// and keeps every label inside its tile. A heatmap 640px wide or narrower, as on a phone, gets the tall layout, a wider
// one the wide; both are on the page and a container query on the heatmap's own width shows one. The switch shows each
// player's win chance added per game, or how far it moved over the past 7 days, on the tiles and in their colour, blue
// up and orange down, with no legend: the figure is on the tile. A tile's tooltip, on hover or a tap, has his minutes
// and both figures, and the table under it every value. The table is what a keyboard or a screen reader reads, so the
// tiles, which repeat it, are hidden from both.
import Segmented from "./Segmented.astro";
import type { PlayerPart } from "../lib/elo.ts";
import { MODES, TEAM_TALL, TEAM_WIDE, teamMap, type Bin, type Canvas, type Mode } from "../lib/heatmap.ts";

interface Props {
  /** The players a team's rating counts, at least one. */
  players: readonly PlayerPart[];
  /** What the table view lists, as its accessible name: "Thunder players". */
  label: string;
}

const { players, label } = Astro.props;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
/** A box's place on its canvas, in percentages. */
const box = (r: { x: number; y: number; w: number; h: number }, canvas: Canvas) =>
  `left: ${pct(r.x, canvas.w)}; top: ${pct(r.y, canvas.h)}; width: ${pct(r.w, canvas.w)}; height: ${pct(r.h, canvas.h)}`;
const fill = (b: Bin | "out") => (b === "out" ? "var(--stripes)" : b === 0 ? "var(--heat-0)" : `var(--heat-${b > 0 ? "up" : "down"}-${Math.abs(b)})`);
const MODE_LABEL: Record<Mode, string> = { game: "Win % per game", week: "7 day change" };
const layouts = [{ name: "wide", canvas: TEAM_WIDE }, { name: "tall", canvas: TEAM_TALL }].map((l) => ({ ...l, tiles: teamMap(players, l.canvas) }));
// Both layouts hold the same tiles, largest first, in a different place: a tile's index in either is its row in the
// table and the tooltips, so their text is written once.
const rows = layouts[0].tiles;
/** Each row's tooltip: his name, a row each of [figure, what it is, its key's fill], and his minutes or that he is out. */
const tips = rows.map(({ name, part, text, bins }) => {
  const minutes = Math.round(part.minutes);
  return {
    name,
    rows: [
      [text.game, part.out ? "win chance per game while out" : "win chance per game", fill(bins.game)],
      [text.week, "7 day change", fill(bins.week)],
    ],
    note: part.out ? `Out for weeks · backups play his ${minutes} min` : `${minutes} min a game`,
  };
});
---

<div class="hm" data-heatmap data-mode="game">
  <div class="bar"><Segmented label="Show" options={MODES.map((m) => ({ label: MODE_LABEL[m], value: m, pressed: m === "game" }))} /></div>
  {layouts.map(({ name, canvas, tiles }) => (
    <div class:list={["canvas", name]} style={`aspect-ratio: ${canvas.w} / ${canvas.h}; --W: ${canvas.w}`}>
      {tiles.map((t, i) => (
        <div
          class:list={["cell", { out: t.part.out }]}
          aria-hidden="true"
          data-cell={i}
          style={`${box(t, canvas)}; --fs: ${(t.label?.size ?? 0).toFixed(2)}; --c-game: ${fill(t.bins.game)}; --c-week: ${fill(t.bins.week)}`}
        >
          {t.label && <span class="nm">{t.label.name}</span>}
          {t.label?.lines === 2 && MODES.map((m) => <span class="fig" data-for={m}>{t.figures[m]}</span>)}
        </div>
      ))}
    </div>
  ))}
  <div class="tip" data-heatmap-tip hidden></div>
  <script
    type="application/json"
    data-heatmap-tips
    set:html={JSON.stringify(tips).replace(/</g, "\\u003c")}
  />

  <details class="table">
    <summary>Every value</summary>
    <div class="scroll">
      <table class="ruled" aria-label={label}>
        <thead>
          <tr>
            <th scope="col">Player</th>
            <th class="num" scope="col">Min</th>
            <th class="num" scope="col">Win %</th>
            <th class="num" scope="col">7 day change</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((t) => (
            <tr>
              <td class="who">{t.name}{t.part.out && <span class="flag"> · out</span>}</td>
              <td class="num">{Math.round(t.part.minutes)}</td>
              <td class="num">{t.text.game}</td>
              <td class="num">{t.text.week}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>

<script>
  import { placeTip } from "../scripts/tip.ts";

  /** A tooltip as the page writes it: his name, a row each of [figure, what it is, its key's fill], and a note. */
  type Tip = { name: string; rows: [string, string, string][]; note: string };
  const isText = (v: unknown): v is string => typeof v === "string";
  const isRecord = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null;
  const isTips = (v: unknown): v is Tip[] =>
    Array.isArray(v) && v.every((t) => isRecord(t) && isText(t.name) && isText(t.note) && Array.isArray(t.rows) && t.rows.every((r) => Array.isArray(r) && r.every(isText)));
  const el = (tag: string, text: string, className?: string) => {
    const e = document.createElement(tag);
    e.textContent = text;
    if (className) e.className = className;
    return e;
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-heatmap]")) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("button[data-value]")];
    for (const b of buttons) {
      b.addEventListener("click", () => {
        root.dataset.mode = b.dataset.value;
        for (const o of buttons) o.setAttribute("aria-pressed", String(o === b));
      });
    }

    const tip = root.querySelector<HTMLElement>("[data-heatmap-tip]");
    const tips: unknown = JSON.parse(root.querySelector("[data-heatmap-tips]")?.textContent ?? "[]");
    if (!tip || !isTips(tips)) continue;
    const cellOf = (t: EventTarget | null) => (t instanceof Element ? t.closest<HTMLElement>("[data-cell]") : null);
    let shown: HTMLElement | null = null;
    const show = (cell: HTMLElement, at: PointerEvent) => {
      if (cell !== shown) {
        const t = tips[Number(cell.dataset.cell)];
        if (!t) return;
        const rows = t.rows.map(([value, label, fill]) => {
          const row = el("span", "", "part");
          const key = el("i", "");
          key.style.background = fill;
          row.append(key, el("strong", value), el("b", label));
          return row;
        });
        tip.replaceChildren(el("span", t.name, "who"), ...rows, el("span", t.note, "foot"));
        shown = cell;
      }
      tip.hidden = false;
      placeTip({ tip, area: root, at, side: "above-or-below" });
    };
    const hide = () => (tip.hidden = true);
    const onPointer = (e: PointerEvent) => {
      const cell = cellOf(e.target);
      if (cell) show(cell, e);
      else if (e.type === "pointermove") hide();
    };
    root.addEventListener("pointermove", onPointer);
    root.addEventListener("pointerdown", onPointer);
    root.addEventListener("pointerleave", (e) => e.pointerType !== "touch" && hide());
    document.addEventListener("pointerdown", (e) => { if (!(e.target instanceof Node && root.contains(e.target))) hide(); });
  }
</script>

<style>
  .hm {
    position: relative; container: heatmap / inline-size;
    --heat-up-1: color-mix(in oklab, var(--rise) 35%, var(--heat-base)); --heat-up-2: color-mix(in oklab, var(--rise) 58%, var(--heat-base));
    --heat-up-3: color-mix(in oklab, var(--rise) 80%, var(--heat-base)); --heat-up-4: var(--rise);
    --heat-down-1: color-mix(in oklab, var(--drop) 35%, var(--heat-base)); --heat-down-2: color-mix(in oklab, var(--drop) 58%, var(--heat-base));
    --heat-down-3: color-mix(in oklab, var(--drop) 80%, var(--heat-base)); --heat-down-4: var(--drop);
    --stripes: repeating-linear-gradient(135deg, var(--heat-out) 0 4px, var(--heat-0) 4px 8px);
  }
  .bar { margin-bottom: 12px; }
  .tip { --tip-figure: 40px; }
  .canvas { position: relative; width: 100%; container-type: inline-size; background: var(--ground); border-radius: 4px; overflow: hidden; }
  .tall { display: none; }
  @container heatmap (max-width: 640px) {
    .wide { display: none; }
    .tall { display: block; }
  }
  /* Canvas px to the screen: n canvas px are n * 100cqw / W. */
  .cell {
    position: absolute; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: calc(2 * 100cqw / var(--W)) calc(3 * 100cqw / var(--W)); border-radius: 2px;
    background: var(--c-game); color: var(--text); text-align: center; line-height: 1.15; white-space: nowrap;
    font-size: calc(var(--fs) * 100cqw / var(--W)); transition: background-color 200ms ease;
  }
  .hm[data-mode="week"] .cell { background: var(--c-week); }
  .hm[data-mode="game"] [data-for="week"], .hm[data-mode="week"] [data-for="game"] { display: none; }
  .cell.out { color: var(--muted); }
  /* Over the week a player out for weeks shows how far his slot fell, striped over its colour. */
  .hm[data-mode="week"] .cell.out { background: repeating-linear-gradient(135deg, rgb(0 0 0 / 0.35) 0 4px, transparent 4px 8px), var(--c-week); color: var(--text); }
  .cell:hover { box-shadow: inset 0 0 0 2px var(--text); z-index: 1; }
  .nm { font-weight: 700; }
  .fig { font-size: 0.85em; font-weight: 500; font-variant-numeric: tabular-nums; }

  .table { margin-top: 12px; }
  summary { width: max-content; color: var(--muted); cursor: pointer; }
  summary:hover { color: var(--text); }
  /* A name with no space to break at, such as Gilgeous-Alexander, can leave the table wider than a phone: it scrolls
     in its own box rather than the page sideways. */
  .scroll { margin-top: 8px; overflow-x: auto; }
  th { padding: 0 8px 2px; }
  td { height: 28px; padding: 0 8px; }
  th:first-child, td:first-child { padding-left: 0; }
  th:last-child, td:last-child { padding-right: 0; }
  .num { text-align: right; }
  /* A long name wraps in its cell rather than pushing the table past a phone's width. */
  td.who { color: var(--text); white-space: normal; }
  .flag { color: var(--muted); }
</style>
