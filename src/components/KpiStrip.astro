---
// Headline figures in a row across a card, split by hairlines: label over value, with an optional grey unit
// after the value.
import type { HTMLAttributes } from "astro/types";

export type Kpi = {
  label: string;
  /** Already formatted. */
  value: string;
  /** A short grey suffix, such as "tied 8th". */
  unit?: string;
};

interface Props extends HTMLAttributes<"dl"> {
  items: Kpi[];
  /** The strip's accessible name. */
  label: string;
}

const { items, label, class: cls, ...rest } = Astro.props;
---

<dl {...rest} class:list={["kpis", cls]} aria-label={label} style={`--n: ${items.length}`}>
  {items.map((k) => (
    <div class="kpi">
      <dt>{k.label}</dt>
      <dd class="value num">{k.value}{k.unit && <small>{k.unit}</small>}</dd>
    </div>
  ))}
</dl>

<style>
  /* Inside a card: its first figure starts on the card's left edge, under the card's title. */
  .kpis { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); margin: 0 calc(-1 * var(--card-pad)); border-top: 1px solid var(--border); }
  .kpi { min-width: 0; padding: 12px var(--card-pad) 4px; }
  .kpi + .kpi { border-left: 1px solid var(--border); }
  dt { color: var(--muted); font-weight: 500; }
  .value { margin-top: 4px; font-size: var(--fs-kpi); line-height: 34px; letter-spacing: -0.01em; white-space: nowrap; }
  small { margin-left: 6px; font-size: var(--fs-body); color: var(--muted); letter-spacing: 0; }

  @media (max-width: 640px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kpi + .kpi { border-left: 0; }
    .kpi:nth-child(even) { border-left: 1px solid var(--border); }
    .kpi:nth-child(n + 3) { border-top: 1px solid var(--border); }
    .kpi:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .value { font-size: 24px; line-height: 30px; }
  }
</style>
