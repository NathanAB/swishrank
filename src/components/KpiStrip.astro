---
// Headline figures in one container split by hairlines: label over value, an optional grey unit after
// the value and a caption that says what the figure is measured against.
import type { HTMLAttributes } from "astro/types";

export type Kpi = {
  label: string;
  /** Already formatted (int(), signed(), DASH for nothing to show). */
  value: string;
  /** A short grey suffix: "pts", "of 1,322". */
  unit?: string;
  /** One grey line naming the window or the case: "Oct 20 to Oct 24". */
  caption?: string;
};

interface Props extends HTMLAttributes<"dl"> {
  items: Kpi[];
  /** The strip's accessible name. */
  label: string;
  /** The first figure is the screen's answer: set 1.3 times the others, with a phone's first row to itself. */
  lead?: boolean;
}

const { items, label, lead = false, class: cls, ...rest } = Astro.props;
---

<dl {...rest} class:list={["kpis", cls, { lead }]} aria-label={label} style={`--n: ${items.length}`}>
  {items.map((k) => (
    <div class="kpi">
      <dt>{k.label}</dt>
      <dd class="value num">{k.value}{k.unit && <small>{k.unit}</small>}</dd>
      {k.caption && <dd class="cap">{k.caption}</dd>}
    </div>
  ))}
</dl>

<style>
  .kpis {
    display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    background: var(--surface); border: var(--panel-edge); box-shadow: var(--shadow); border-radius: var(--radius-card);
  }
  .kpi { min-width: 0; padding: 14px var(--card-pad) 16px; }
  .kpi + .kpi { border-left: 1px solid var(--border); }
  dt { color: var(--muted); font-weight: 500; }
  .value { --size: var(--fs-kpi); margin-top: 4px; font-size: var(--size); line-height: 34px; letter-spacing: -0.01em; white-space: nowrap; }
  /* The line box stays the siblings' height, so every caption in the strip sits on one line. */
  .lead > .kpi:first-child .value { font-size: calc(var(--size) * 1.3); }
  small { margin-left: 4px; font-size: var(--fs-body); color: var(--muted); letter-spacing: 0; }
  .cap { margin-top: 2px; color: var(--muted); font-size: var(--fs-small); line-height: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  @media (max-width: 640px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kpi + .kpi { border-left: 0; }
    .kpi:nth-child(even) { border-left: 1px solid var(--border); }
    .kpi:nth-child(n + 3) { border-top: 1px solid var(--border); }
    .kpi:last-child:nth-child(odd) { grid-column: 1 / -1; }
    /* A lead takes the first row, so the figures after it pair up from the second. */
    .lead > .kpi:first-child, .lead > .kpi:last-child:nth-child(even) { grid-column: 1 / -1; }
    .lead > .kpi:last-child:nth-child(odd):not(:first-child) { grid-column: auto; }
    .lead > .kpi:nth-child(even) { border-left: 0; }
    .lead > .kpi:nth-child(odd):not(:first-child) { border-left: 1px solid var(--border); }
    .lead > .kpi:nth-child(2) { border-top: 1px solid var(--border); }
    .value { --size: 24px; line-height: 30px; }
  }
</style>
