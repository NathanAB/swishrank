---
// A team's projections on its page in the season in progress: three figures down the left, its projected record, its
// chance of the playoffs and its chance of the title (or of the first draft pick, for a team likelier to win the
// lottery than the title), each chance with its move this week; and beside them where it finishes, its chance of each
// seed in its conference, coloured by what the seed means as the odds page's season results are, with the league's
// cut lines named under them. On a phone the figures run across the top and the seeds sit under them. Pointing at,
// focusing or tapping a seed reads out its chance.
import Panel from "./Panel.astro";
import type { Abbr } from "../lib/elo.ts";
import { record } from "../lib/format.ts";
import type { SeasonOdds } from "../lib/odds.ts";
import { moveWords, oddsPct } from "../lib/race.ts";
import { standingsRecord } from "../lib/teams.ts";
import { team, type SeasonView } from "../lib/season.ts";

interface Props {
  season: SeasonView;
  abbr: Abbr;
  odds: SeasonOdds;
}

const { season, abbr, odds } = Astro.props;
const o = odds.teams[abbr];
const me = team(season, abbr);
const wins = Math.round(o.wins);
const move = (key: "title" | "playoffs") => moveWords(odds.history, abbr, key);
const pick = o.firstPick > o.title;
const whose = me.short.endsWith("s") ? `${me.short}'` : `${me.short}'s`;
const figures = [
  { label: "Projected record", value: record(wins, 82 - wins), note: { text: `Now ${record(...standingsRecord(season.model, abbr))}`, sign: 0 } },
  { label: "Make the playoffs", value: oddsPct(o.playoffs), note: move("playoffs") },
  pick ? { label: "No. 1 draft pick", value: oddsPct(o.firstPick), note: null } : { label: "Win the title", value: oddsPct(o.title), note: move("title") },
];
const ordinal = (n: number) => n + (n % 100 >= 11 && n % 100 <= 13 ? "th" : ["th", "st", "nd", "rd"][n % 10] ?? "th");
const most = Math.max(...o.seed, 0.1);
const colourOf = (i: number) => (i < 6 ? "var(--result-top6)" : i < 10 ? "var(--result-playin)" : "var(--result-lottery)");
const seeds = o.seed.map((p, i) => ({ seed: i + 1, p, height: (p / most) * 100, colour: colourOf(i), text: `${ordinal(i + 1)} seed: ${oddsPct(p)}` }));
---

<Panel title="Projections">
  <div class="projections">
    <dl class="figs" aria-label={`The ${whose} projections`}>
      {figures.map((f) => (
        <div class="fig">
          <dt>{f.label}</dt>
          <dd class="value num">{f.value}</dd>
          {f.note && <dd class:list={["note", { up: f.note.sign > 0, down: f.note.sign < 0 }]}>{f.note.text}</dd>}
        </div>
      ))}
    </dl>
    <div class="finish" data-seeds>
      <p class="sub">Where they finish</p>
      <div class="cols" role="list" aria-label={`The ${whose} chance of each seed in their conference`}>
        {seeds.map((s) => (
          <div class="col" role="listitem" tabindex="0" aria-label={s.text} data-text={s.text}>
            <span class="track"><i style={`height: ${s.height}%; background: ${s.colour}`}></i></span>
            <span class="seed num">{s.seed}</span>
          </div>
        ))}
      </div>
      <div class="cuts" aria-hidden="true"><span style="grid-column: 1 / 7">Top 6</span><span style="grid-column: 7 / 11">Play-in</span><span style="grid-column: 11 / 16">Lottery</span></div>
      <div class="tip" data-seed-tip hidden></div>
    </div>
  </div>
</Panel>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-seeds]")) {
    const tip = root.querySelector<HTMLElement>("[data-seed-tip]")!;
    const show = (col: HTMLElement, x: number, finger: boolean) => {
      tip.textContent = col.dataset.text ?? "";
      tip.hidden = false;
      const area = root.getBoundingClientRect();
      const top = col.querySelector(".track")!.getBoundingClientRect().top - area.top;
      const w = tip.offsetWidth, h = tip.offsetHeight;
      const left = Math.max(0, Math.min(x - area.left - w / 2, area.width - w));
      tip.style.transform = `translate(${left}px, ${Math.max(0, top - h - (finger ? 16 : 8))}px)`;
    };
    for (const col of root.querySelectorAll<HTMLElement>("[data-text]")) {
      col.addEventListener("pointerenter", (e) => show(col, e.clientX, e.pointerType === "touch"));
      col.addEventListener("pointerdown", (e) => show(col, e.clientX, e.pointerType === "touch"));
      col.addEventListener("pointerleave", (e) => { if (e.pointerType !== "touch") tip.hidden = true; });
      col.addEventListener("focus", () => { const r = col.getBoundingClientRect(); show(col, r.left + r.width / 2, false); });
      col.addEventListener("blur", () => (tip.hidden = true));
    }
    document.addEventListener("pointerdown", (e) => { if (!(e.target instanceof Node && root.contains(e.target))) tip.hidden = true; });
  }
</script>

<style>
  /* The figures in a column a row each, ruled apart, beside the seeds; the two stand the same height. */
  .projections { display: grid; grid-template-columns: minmax(220px, 300px) minmax(0, 1fr); gap: 40px; align-items: stretch; margin-top: 10px; }
  .figs { display: grid; grid-template-rows: repeat(3, 1fr); }
  .fig { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 12px; align-content: center; padding: 10px 0; border-top: 1px solid var(--rule); min-width: 0; }
  .fig:first-child { border-top: 0; padding-top: 0; }
  .fig:last-child { padding-bottom: 0; }
  dt { grid-column: 1 / -1; color: var(--muted); font-size: var(--fs-small); line-height: 16px; margin-bottom: 2px; }
  dd { margin: 0; }
  .value { font-size: 32px; line-height: 36px; font-weight: 700; letter-spacing: -0.02em; }
  .note { align-self: end; padding-bottom: 5px; color: var(--muted); font-size: var(--fs-small); line-height: 16px; }
  .note.up { color: var(--rise); }
  .note.down { color: var(--drop); }
  .finish { position: relative; display: grid; grid-template-rows: auto 1fr auto; gap: 8px; min-width: 0; }
  .sub { font-size: 13px; line-height: 18px; font-weight: 600; }
  /* Fifteen columns, each bar at most 24px wide, rounded at its top and square on the baseline. */
  .cols { display: grid; grid-template-columns: repeat(15, minmax(0, 1fr)); min-height: 120px; border-bottom: 1px solid var(--control); }
  .col { display: grid; grid-template-rows: 1fr; position: relative; cursor: default; border-radius: 3px; }
  .col:hover, .col:focus-visible { background: color-mix(in oklab, var(--text) 6%, transparent); }
  .track { display: flex; align-items: flex-end; justify-content: center; height: 100%; padding-top: 4px; }
  .track i { width: min(24px, calc(100% - 4px)); min-height: 1px; border-radius: 4px 4px 0 0; }
  .seed { position: absolute; left: 0; right: 0; bottom: -20px; text-align: center; color: var(--muted); font-size: 11px; line-height: 14px; }
  .cuts { display: grid; grid-template-columns: repeat(15, minmax(0, 1fr)); margin-top: 22px; color: var(--muted); font-size: 11px; line-height: 14px; }
  .cuts span { text-align: center; padding-top: 5px; margin: 0 3px; border-top: 1px solid var(--control); }
  .tip { white-space: nowrap; }

  /* On a tablet or a phone the figures run across, three abreast, and the seeds stand under them. */
  @media (max-width: 900px) {
    .projections { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .figs { grid-template-rows: none; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .fig, .fig:first-child, .fig:last-child { grid-template-columns: minmax(0, 1fr); align-content: start; padding: 0; border: 0; }
    .note { padding-bottom: 0; }
    .cols { min-height: 120px; height: 120px; }
  }
  @media (max-width: 640px) {
    .value { font-size: 26px; line-height: 30px; }
    .cols { min-height: 104px; height: 104px; }
  }
</style>
