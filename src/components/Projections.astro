---
// A team's projections on its page in the season in progress: three figures down the left, its projected record, its
// chance of the playoffs and its chance of the title (or of the first draft pick, for a team likelier to win the
// lottery than the title), each chance with its move this week; and beside them whatever the page slots in, the
// team's rating chart on its own page. On a tablet or a phone the figures run across the top and the slot sits under
// them.
import Panel from "./Panel.astro";
import type { Abbr } from "../lib/elo.ts";
import { record } from "../lib/format.ts";
import type { SeasonOdds } from "../lib/odds.ts";
import { moveWords, oddsPct } from "../lib/race.ts";
import { standingsRecord } from "../lib/teams.ts";
import { team, type SeasonView } from "../lib/season.ts";

interface Props {
  season: SeasonView;
  abbr: Abbr;
  odds: SeasonOdds;
}

const { season, abbr, odds } = Astro.props;
const o = odds.teams[abbr];
const me = team(season, abbr);
const wins = Math.round(o.wins);
const move = (key: "title" | "playoffs") => moveWords(odds.history, abbr, key);
const pick = o.firstPick > o.title;
const whose = me.short.endsWith("s") ? `${me.short}'` : `${me.short}'s`;
const figures = [
  { label: "Projected record", value: record(wins, 82 - wins), note: { text: `Now ${record(...standingsRecord(season.model, abbr))}`, sign: 0 } },
  { label: "Make the playoffs", value: oddsPct(o.playoffs), note: move("playoffs") },
  pick ? { label: "No. 1 draft pick", value: oddsPct(o.firstPick), note: null } : { label: "Win the title", value: oddsPct(o.title), note: move("title") },
];
---

<Panel title="Projections">
  <div class="projections">
    <dl class="figs" aria-label={`The ${whose} projections`}>
      {figures.map((f) => (
        <div class="fig">
          <dt>{f.label}</dt>
          <dd class="value num">{f.value}</dd>
          {f.note && <dd class:list={["note", { up: f.note.sign > 0, down: f.note.sign < 0 }]}>{f.note.text}</dd>}
        </div>
      ))}
    </dl>
    <div class="beside"><slot /></div>
  </div>
</Panel>

<style>
  /* The figures in a column a row each, ruled apart, beside the slot; the two stand the same height. */
  .projections { display: grid; grid-template-columns: minmax(220px, 300px) minmax(0, 1fr); gap: 40px; align-items: stretch; margin-top: 10px; }
  .figs { display: grid; grid-template-rows: repeat(3, 1fr); }
  .fig { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 12px; align-content: center; padding: 10px 0; border-top: 1px solid var(--rule); min-width: 0; }
  .fig:first-child { border-top: 0; padding-top: 0; }
  .fig:last-child { padding-bottom: 0; }
  dt { grid-column: 1 / -1; color: var(--muted); font-size: var(--fs-small); line-height: 16px; margin-bottom: 2px; }
  dd { margin: 0; }
  .value { font-size: 32px; line-height: 36px; font-weight: 700; letter-spacing: -0.02em; }
  .note { align-self: end; padding-bottom: 5px; color: var(--muted); font-size: var(--fs-small); line-height: 16px; }
  .note.up { color: var(--rise); }
  .note.down { color: var(--drop); }
  .beside { min-width: 0; }

  /* On a tablet or a phone the figures run across, three abreast, and the slot stands under them. */
  @media (max-width: 900px) {
    .projections { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .figs { grid-template-rows: none; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .fig, .fig:first-child, .fig:last-child { grid-template-columns: minmax(0, 1fr); align-content: start; padding: 0; border: 0; }
    .note { padding-bottom: 0; }
  }
  @media (max-width: 640px) {
    .value { font-size: 26px; line-height: 30px; }
  }
</style>
