---
// One day's games still to play, two lines each (away, then home): tip-off in US Eastern on the first line,
// and each side's win chance from today's ratings, the favourite in ink, whether home or away.
import GameDay from "./GameDay.astro";
import { heads } from "../lib/columns.ts";
import type { FixtureDay } from "../lib/fixtures.ts";
import { longDay, pct, tipTime, weekdayDay } from "../lib/format.ts";
import { href } from "../lib/routes.ts";
import { team, type SeasonView } from "../lib/season.ts";

interface Props {
  season: SeasonView;
  day: FixtureDay;
  /** Label the columns: the first day of a section does. */
  labels?: boolean;
}

const { season, day, labels = false } = Astro.props;
const n = day.fixtures.length;
---

<GameDay heading={weekdayDay(day.day)} label={`Games on ${longDay(day.day)}`} count={n} cols="72px minmax(0, 1fr) 72px" labels={labels ? ["Win chance"] : []}>
  {day.fixtures.map((f, i) => (
    <li class:list={["g", heads(i, n)]}>
      {f.lines.map((l, k) => (
        <div class:list={["ln", { fav: l.side === f.fav }]}>
          <span class="when num">{k === 0 && tipTime(f.game.t)}</span>
          <span class="who">{l.side === "h" && (f.game.neutral ? "vs " : "at ")}<a class="nm" href={href({ kind: "team", season, abbr: l.abbr })}>{team(season, l.abbr).short}</a></span>
          <span class="r num">{pct(l.chance)}</span>
        </div>
      ))}
    </li>
  ))}
</GameDay>

<style>
  .ln { color: var(--muted); }
  .ln span { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .r { text-align: right; }
  .fav { color: var(--text); font-weight: 500; }
  .fav .when { color: var(--muted); font-weight: 400; }
  .nm:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
