---
// One line that says what a rating means, for a reader who has never met Elo. The page places it with its own
// class; other attributes land on the paragraph too.
import type { HTMLAttributes } from "astro/types";
import { START } from "../lib/elo.ts";
import { rating } from "../lib/format.ts";

type Props = HTMLAttributes<"p">;

const { class: cls, ...rest } = Astro.props;
---

<p {...rest} class:list={["key", cls]}>
  Ratings are loosely based on the Elo points scale from chess. A {rating(START)} rating is roughly average.<slot />
</p>

<style>
  .key { color: var(--muted); }
  .key a:hover { text-decoration-color: currentColor; }
</style>
