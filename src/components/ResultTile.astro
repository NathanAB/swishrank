---
// One final game as a tile: away over home, each with its score and, smaller, its rating change as displayed.
// The whole tile opens the game's page; each team's name opens its own.
// The winner is in ink. An upset's tile lights up in the accent, with a badge naming the winner and the chance
// the ratings gave them. The games page lists these tiles.
import UpsetBadge from "./UpsetBadge.astro";
import { upset, type Outcome } from "../lib/facts.ts";
import { between, matchup, pct, signed } from "../lib/format.ts";
import { href } from "../lib/routes.ts";
import { team, type SeasonView } from "../lib/season.ts";

interface Props {
  season: SeasonView;
  outcome: Outcome;
}

const { season, outcome: o } = Astro.props;
const isUpset = upset(o);
---

<li class:list={["tile", { upset: isUpset }]}>
  <a class="cover" href={href({ kind: "game", season, game: o.result.game })} aria-label={`${matchup(team(season, o.away.abbr).short, team(season, o.home.abbr).short, o.result.game.neutral)}, ${o.away.score}–${o.home.score}`}></a>
  {isUpset && (
    <p class="top">
      <span class="up">
        <UpsetBadge class="tag" />
        <span class="had">{team(season, o.winner.abbr).short} had a {pct(o.winner.chance)} chance</span>
      </span>
    </p>
  )}
  {[o.away, o.home].map((l) => (
    <div class:list={["ln", { win: l.won }]}>
      <span class="who">{l.side === "h" && `${between(o.result.game.neutral)} `}<a class="nm" href={href({ kind: "team", season, abbr: l.abbr })}>{team(season, l.abbr).short}</a></span>
      <span class="sc num">{l.score}</span>
      <span class:list={["ch num", { paid: isUpset && l.won }]}>{signed(l.change)}</span>
    </div>
  ))}
</li>

<style>
  /* Name, score and rating change on one grid, so the two lines' figures line up. */
  /* A tile without an upset tag keeps its two lines together, level with its neighbours' below their tags. */
  .tile { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-content: end; column-gap: 16px; }
  .top, .ln { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; align-items: baseline; }
  .top { margin-bottom: 2px; font-size: var(--fs-small); line-height: 16px; color: var(--muted); }
  .up { grid-column: 1 / -1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* An upset stands out from every other tile: an accent ring and wash, a filled badge, and the winner's gain
     in the accent, since the ratings paid out most for it. */
  .tile.upset { background: color-mix(in oklab, var(--accent) 12%, var(--raised)); box-shadow: inset 0 0 0 1.5px var(--accent); }
  .tile.upset:has(> .cover:hover) { background: color-mix(in oklab, var(--accent) 24%, var(--raised)); }
  .tag { margin-right: 6px; }
  .had { color: var(--text); font-weight: 500; }
  .ln { color: var(--muted); line-height: 22px; }
  .who { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sc, .ch { text-align: right; }
  .ch { font-size: var(--fs-small); }
  .win { color: var(--text); font-weight: 500; }
  .win .ch:not(.paid) { color: var(--muted); font-weight: 400; }
  .nm:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
