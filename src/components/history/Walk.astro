---
// A day's walk, from the rating before to the rating after, on the day's own scale. The axis on top holds the two
// ratings, with a faint line down from each; under it each part's heading carries its figure, and each step is a bar
// from the running rating, its figure at the end it moved to, drops and rises in two colours. On a phone each bar
// sits on a track of the scale, and the axis splits: the rating before at the top, the rating after at the bottom.
// `id` names the walk on its page, so its drawers' ids are unique and the same on every build.
import { signed, signedTenth } from "../../lib/format.ts";
import type { Walk, WalkLine, WalkPart } from "../../lib/ledger.ts";

interface Props { walk: Walk; id: string }
const { walk: { from, to, parts, tipped }, id } = Astro.props;

// The day's own scale: from the lowest to the highest rating the walk passes through, 2 points at least.
let at = from, lo = from, hi = from;
for (const part of parts) for (const l of part.lines) { at += l.whole; lo = Math.min(lo, at); hi = Math.max(hi, at); }
if (hi - lo < 2) { lo -= (2 - (hi - lo)) / 2; hi = lo + 2; }
const place = (v: number) => ((v - lo) / (hi - lo)).toFixed(4);
const share = (n: number) => (Math.abs(n) / (hi - lo)).toFixed(4);
/** Which end of the scale a rating sits on, if either, so its label and figure can stay inside the chart. */
const edge = (v: number) => (v === lo ? "at-lo" : v === hi ? "at-hi" : null);
/**
 * Whether the two ratings sit too near each other for both labels on one line. A label kept inside the chart can
 * lean up to about 32px past its rating towards the other, and a phone's chart can be as narrow as about 150px.
 */
const close = from !== to && Math.abs(from - to) / (hi - lo) < 0.25;

type Step =
  | { kind: "head"; part: WalkPart }
  | { kind: "line"; part: WalkPart; line: WalkLine; x: number; bar: number; drawer: string | null };
let run = from;
let bar = 0;
const steps: Step[] = parts.flatMap((part): Step[] => {
  const lines = part.lines.map((line): Step => {
    const x = run;
    run += line.whole;
    // Effects under a point always fold into one closed line, however few, so they never crowd the lines that count.
    const drawer = line.kind === "group" && line.items.length > 0 ? `${id}-${part.key}` : null;
    return { kind: "line", part, line, x, bar: line.whole !== 0 ? bar++ : 0, drawer };
  });
  // Every part reads the same way: its heading with its figure, then its lines.
  return [{ kind: "head", part }, ...lines];
});

/** What rounding did to a closing line, when it moved the line by half a point or more: "+0.2 in all, rounded to +1". */
const rounding = (l: WalkLine) => (l.kind === "group" && Math.abs(l.points - l.whole) >= 0.5 ? `${signedTenth(l.points)} in all, rounded to ${signed(l.whole)}` : "");
/**
 * A line's two lines of words, the same shape on every line: a name, and a few words under it. The game's own line is
 * "The game" and how it went; a closing line names what it folds ("4 players") over how small each is, or what
 * rounding did.
 */
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const words = (s: Extract<Step, { kind: "line" }>) => {
  const l = s.line;
  if (l.kind === "group") {
    const [, what = l.phrase, size = ""] = /^(.*?) (under a .*)$/.exec(l.phrase) ?? [];
    return { name: cap(what), why: rounding(l) || cap(size) };
  }
  return l.kind === "team" ? { name: "The game", why: l.phrase } : { name: l.name, why: l.phrase };
};
/** The note for a small move made a whole point by rounding, unless a line already says what rounding did. */
const note = tipped && !steps.some((s) => s.kind === "line" && words(s).why === rounding(s.line) && rounding(s.line));
const chev = `<svg class="chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<div class="wrap"><div class="walk" style={`--from:${place(from)};--to:${place(to)}`}>
  <div class="gridlines" aria-hidden="true"><i style={`--p:${place(from)}`} /><i style={`--p:${place(to)}`} /></div>
  <div class:list={["step axis", { close }]}>
    <span class="s-label"></span>
    <span class="s-chart">
      {from === to ? (
        <span class:list={["tick num to-mid", edge(to)]} style={`--p:${place(to)}`}><span class="muted">From and to</span> {to}</span>
      ) : (
        <>
          {/* Each label points away from the other, the lower rating's to the left and the higher's to the right. */}
          <span class:list={["tick num", from < to ? "to-left" : "to-right"]} style={`--p:${place(from)}`}><span class="t-in"><span class="muted">From</span> {from}</span></span>
          <span class:list={["tick num to", from < to ? "to-right" : "to-left"]} style={`--p:${place(to)}`}><span class="t-in"><span class="muted">To</span> {to}</span></span>
        </>
      )}
    </span>
  </div>
  {steps.map((s) => {
    if (s.kind === "head") return (
      <div class="step head"><span class="s-label">{s.part.label} <span class="h-fig num">{signed(s.part.whole)}</span></span><span class="s-chart"></span></div>
    );
    const { name, why } = words(s);
    const l = s.line;
    const label = (
      <>
        <span class="s-name">{name}{s.drawer && <Fragment set:html={chev} />}</span>
        {why && <span class="s-why">{why}</span>}
      </>
    );
    const list = l.kind === "group" && l.items.length > 0 && (
      <ul class="drawer">
        {l.items.map((it) => <li><span><span class="s-name">{it.name}</span>{it.phrase && <span class="s-why">{it.phrase}</span>}</span><span class="num">{signedTenth(it.points)}</span></li>)}
      </ul>
    );
    return (
      <div class:list={["step", { flat: l.whole === 0, group: l.kind === "group" }]}>
        <span class="s-label">{s.drawer ? <button type="button" class="drawer-btn" aria-expanded="false" aria-controls={s.drawer}>{label}</button> : label}</span>
        <span class="s-chart">
          {l.whole !== 0 && <b class:list={["bar", l.whole < 0 ? "down" : "up", edge(s.x + l.whole)]} style={`--p:${place(Math.min(s.x, s.x + l.whole))};--w:${share(l.whole)};--i:${s.bar}`}><span class="fig num">{signed(l.whole)}</span></b>}
        </span>
        {list && (s.drawer ? <div class="s-more reveal" id={s.drawer} inert><div class="reveal-in">{list}</div></div> : <div class="s-more">{list}</div>)}
      </div>
    );
  })}
  {/* A phone's walk reads down the page, from the rating before at the top to the rating after under the last bar. */}
  {from !== to && (
    <div class="step axis end" aria-hidden="true">
      <span class="s-label"></span>
      <span class="s-chart"><span class="tick num" style={`--p:${place(to)}`}><span class="muted">To</span> {to}</span></span>
    </div>
  )}
</div>{note && <p class="note">A small move, tipped to a whole point by rounding.</p>}</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("button.drawer-btn[aria-controls]").forEach((b) =>
    b.addEventListener("click", () => {
      const open = b.getAttribute("aria-expanded") !== "true";
      b.setAttribute("aria-expanded", String(open));
      const drawer = document.getElementById(b.getAttribute("aria-controls")!)!;
      drawer.toggleAttribute("data-open", open);
      drawer.inert = !open;
    }),
  );
</script>

<style>
  /* The walk: a label column, and the chart right beside it on the day's own scale. --p is a rating's place along
     the scale (0 to 1), --w a bar's share of it; both resolve inside the chart's padding, --inset, which a side can
     narrow (--in-l, --in-r). */
  .wrap { container-type: inline-size; }
  .walk { --lw: 300px; --cg: 16px; --inset: 52px; --in-l: var(--inset); --in-r: var(--inset); --ease: cubic-bezier(0.2, 0.7, 0.2, 1); position: relative; padding: 4px 0 8px; }
  .step { position: relative; display: grid; grid-template-columns: var(--lw) minmax(0, 1fr); column-gap: var(--cg); --top: 0px; }
  .s-label { padding: calc(var(--top) + 8px) 0 8px; min-width: 0; }
  .s-chart { position: relative; grid-column: 2; grid-row: 1 / span 2; min-height: 32px; }
  .s-more { grid-column: 1; }
  .s-name { display: flex; align-items: center; gap: 6px; line-height: 20px; }
  .s-why { display: block; color: var(--muted); font-size: var(--fs-small); line-height: 16px; }
  .muted { color: var(--muted); }
  .step.head { --top: 10px; }
  .step.head .s-chart { min-height: 30px; }
  .step.head .s-label { font-weight: 600; }
  .h-fig { margin-left: 6px; font-weight: 600; }
  /* Every line is the same: one line of name and one of words, so each takes the same height. */
  .step:not(.head) .s-label { min-height: calc(var(--top) + 52px); }

  /* The axis: the two ratings, and a faint line down from each through the walk. */
  .step.axis .s-chart { min-height: 24px; }
  .tick { --x: calc(var(--in-l) + var(--p) * (100% - var(--in-l) - var(--in-r))); position: absolute; top: 0; white-space: nowrap; font-size: var(--fs-small); line-height: 16px; color: var(--text); }
  .t-in, .to-mid { padding: 0 6px; }
  /* A label sits in a box from its rating to the chart's edge on its side and points that way, unless the box is
     too short for it; then it keeps to the chart's edge and leans back past its rating (safe alignment). The box
     to the right reads right to left, so its overflow, too, keeps to the chart's edge. */
  .tick.to-left, .tick.to-right { display: flex; justify-content: safe flex-end; }
  .tick.to-left { left: 0; width: var(--x); }
  .tick.to-right { left: var(--x); right: 0; direction: rtl; }
  .t-in { direction: ltr; }
  /* Two ratings close together put the second label on a line of its own, so the two never meet. */
  .axis.close .s-chart { min-height: 40px; }
  .axis.close .tick.to { top: 16px; }
  .step.axis.end { display: none; }
  .tick.to-mid { left: var(--x); transform: translateX(-50%); }
  /* A rating at either end of the scale turns its label inward, so it never runs past the chart. */
  .tick.to-mid.at-lo { transform: none; }
  .tick.to-mid.at-hi { transform: translateX(-100%); }
  .gridlines { position: absolute; top: 16px; bottom: 8px; left: calc(var(--lw) + var(--cg)); right: 0; pointer-events: none; }
  .gridlines i { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--grid); left: calc(var(--in-l) + var(--p) * (100% - var(--in-l) - var(--in-r))); }

  /* A step: a bar from the running rating to the next, its figure at the end it moved to. The fill sits in ::before
     so opening can grow it without squeezing the figure. A step whose share is 0 has no bar. */
  .bar { position: absolute; top: calc(var(--top) + 7px); height: 18px; left: calc(var(--in-l) + var(--p) * (100% - var(--in-l) - var(--in-r))); width: max(3px, calc(var(--w) * (100% - var(--in-l) - var(--in-r)))); }
  /* Each bar ends in an arrowhead at the rating it moved to: a drop points left, a rise right. A bar too short for
     a whole head is all head. */
  .bar { --head: min(8px, 100%); }
  .bar::before { content: ""; position: absolute; inset: 0; border-radius: 3px; background: var(--drop); transform-origin: right center; clip-path: polygon(var(--head) 0, 100% 0, 100% 100%, var(--head) 100%, 0 50%); }
  .bar.up::before { background: var(--rise); transform-origin: left center; clip-path: polygon(0 0, calc(100% - var(--head)) 0, 100% 50%, calc(100% - var(--head)) 100%, 0 100%); }
  .fig { position: absolute; top: -1px; line-height: 20px; white-space: nowrap; font-size: 13px; }
  .down .fig { right: 100%; margin-right: 6px; }
  .up .fig { left: 100%; margin-left: 6px; }
  /* Bars grow, one after another, when the panel they sit in opens (it is inert while closed). */
  .bar::before { transition: transform 380ms var(--ease) calc(var(--i, 0) * 40ms); }
  .fig { transition: opacity 200ms ease calc(var(--i, 0) * 40ms + 200ms); }
  :global([inert]) .bar::before { transform: scaleX(0); }
  :global([inert]) .fig { opacity: 0; }

  /* The closing line of items under a point: a drawer of tenths, or the list itself when it is short. */
  .drawer-btn { display: block; width: 100%; padding: 0; border-radius: 3px; text-align: left; }
  .drawer-btn:hover .s-name { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--control); }
  .chev { flex: none; color: var(--muted); transition: transform 280ms var(--ease); }
  .drawer-btn[aria-expanded="true"] .chev { transform: rotate(180deg); }
  .reveal { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 280ms var(--ease), opacity 200ms ease; }
  .reveal[data-open] { grid-template-rows: 1fr; opacity: 1; }
  .reveal-in { min-height: 0; overflow: hidden; }
  .drawer { margin: 0 0 8px; padding-left: 12px; border-left: 1px solid var(--rule); }
  /* A drawer's items read as the walk's lines do: the name, and its words under it. */
  .drawer li { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 12px; padding: 4px 0; }
  .drawer li .num { min-width: 36px; text-align: right; font-size: 13px; line-height: 20px; }

  /* On a phone each label sits over its own bar, close under it, and the gridlines give way to a track under each
     bar: the day's scale from end to end, with a mark at the rating before and the rating after. */
  @container (max-width: 600px) {
    .walk {
      --inset: 44px; --track-h: 18px;
      --track: color-mix(in oklab, var(--text) 4%, transparent); --mark: color-mix(in oklab, var(--text) 18%, transparent);
      padding: 0 0 4px;
    }
    .gridlines { display: none; }
    .step { grid-template-columns: minmax(0, 1fr); }
    .s-label { padding: calc(var(--top) + 14px) 0 0; }
    .s-chart { grid-column: 1; grid-row: 2; min-height: var(--track-h); margin-top: 8px; }
    .s-chart::before {
      content: ""; position: absolute; top: 0; height: var(--track-h); left: var(--in-l); right: var(--in-r); border-radius: 3px;
      background:
        linear-gradient(var(--mark), var(--mark)) calc(var(--from) * 100%) 0 / 1px 100% no-repeat,
        linear-gradient(var(--mark), var(--mark)) calc(var(--to) * 100%) 0 / 1px 100% no-repeat,
        var(--track);
    }
    .s-more { grid-column: 1; grid-row: 3; }
    .step.head { --top: 8px; }
    .step.head + .step .s-label { padding-top: 6px; }
    .step.head .s-chart, .step.flat .s-chart { display: none; }
    .bar { top: 0; height: var(--track-h); }
    /* A figure is backed in the colour it sits on, the track's unless its bar ends at the end of the scale, so no mark
       runs through it. */
    .fig { top: 0; line-height: var(--track-h); padding: 0 3px; border-radius: 3px; background: linear-gradient(var(--track), var(--track)), var(--walk-bg, var(--surface)); }
    .down.at-lo .fig, .up.at-hi .fig { background: none; }
    .down .fig { margin-right: 3px; }
    .up .fig { margin-left: 3px; }
    .drawer { margin-top: 8px; padding-left: 8px; }

    /* The axis splits in two, so the walk reads down the page: the rating before over the first bar and the rating
       after under the last, each on a tick across a hairline of the scale. A label slides along its tick as its
       rating does along the scale, starting at the tick at one end and ending at it at the other, so it never runs
       past the chart. The rating after keeps its place at the top for a screen reader, out of sight. */
    .step.axis .s-label { display: none; }
    .step.axis .s-chart { --track-h: 1px; --tick: var(--from); grid-row: 1; margin-top: 0; min-height: 0; height: 28px; }
    .step.axis .s-chart::before { top: 24px; border-radius: 0; background: var(--mark); }
    .step.axis .s-chart::after { content: ""; position: absolute; top: 19px; width: 1px; height: 9px; background: var(--muted); left: calc(var(--in-l) + var(--tick) * (100% - var(--in-l) - var(--in-r) - 1px)); }
    .step.axis .tick { left: var(--x); right: auto; width: auto; display: block; direction: ltr; transform: translateX(calc(var(--p) * -100%)); }
    .step.axis :is(.t-in, .to-mid) { padding: 0; }
    .step.axis:not(.end) .tick.to { width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .step.axis.end { display: grid; }
    .step.axis.end .s-chart { --tick: var(--to); margin-top: 14px; }
    .step.axis.end .s-chart::before { top: 4px; }
    .step.axis.end .s-chart::after { top: 0; }
    .step.axis.end .tick { top: 14px; }
  }
</style>
