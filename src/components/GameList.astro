---
// One day's final games, one tile each: away over home, each with its score and, smaller, its rating change
// as displayed; the section's header says what the smaller figure is. The winner is in ink. An upset's tile
// lights up in the accent, with a badge naming the winner and the chance the ratings gave them.
import GameDay from "./GameDay.astro";
import { outcome, upset } from "../lib/facts.ts";
import { longDay, pct, signed, weekdayDay } from "../lib/format.ts";
import type { Day } from "../lib/results.ts";
import { href } from "../lib/routes.ts";
import { team, type SeasonView } from "../lib/season.ts";

interface Props {
  season: SeasonView;
  day: Day;
}

const { season, day } = Astro.props;
const games = day.results.map(outcome);

const notes = day.results.map((r) => r.game.note);
const meta = notes.every((n) => n !== null) && notes.length
  ? (notes.length === 1 ? notes[0].split(" - ") : [...new Set(notes.map((n) => n.split(" - ")[0]))]).join(" · ")
  : undefined;
---

<GameDay heading={weekdayDay(day.day)} meta={meta} label={`Games on ${longDay(day.day)}`}>
  {games.map((o) => (
    <li class:list={["g", { upset: upset(o) }]}>
      {upset(o) && (
        <p class="top">
          <span class="up">
            <span class="tag"><svg viewBox="0 0 10 12" aria-hidden="true"><path d="M6 0 0 7h4l-1 5 6-7H5z" /></svg>Upset</span>
            <span class="had">{team(season, o.winner.abbr).short} had a {pct(o.winner.chance)} chance</span>
          </span>
        </p>
      )}
      {[o.away, o.home].map((l) => (
        <div class:list={["ln", { win: l.won }]}>
          <span class="who">{l.side === "h" && (o.result.game.neutral ? "vs " : "at ")}<a class="nm" href={href({ kind: "team", season, abbr: l.abbr })}>{team(season, l.abbr).short}</a></span>
          <span class="sc num">{l.score}</span>
          <span class="ch num">{signed(l.change)}</span>
        </div>
      ))}
    </li>
  ))}
</GameDay>

<style>
  /* Name, score and rating change on one grid, so the two lines' figures line up. */
  /* A tile without an upset tag keeps its two lines together, level with its neighbours' below their tags. */
  .g { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-content: end; column-gap: 16px; }
  .top, .ln { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; align-items: baseline; }
  .top { margin-bottom: 2px; font-size: var(--fs-small); line-height: 16px; color: var(--muted); }
  .up { grid-column: 1 / -1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* An upset stands out from every other tile: an accent ring and wash, a filled badge, and the winner's gain
     in the accent, since the ratings paid out most for it. */
  :global(.gs) .g.upset { background: color-mix(in oklab, var(--accent) 12%, var(--raised)); box-shadow: inset 0 0 0 1.5px var(--accent); }
  .tag {
    display: inline-flex; align-items: center; gap: 3px; margin-right: 6px; padding: 1px 6px; border-radius: 3px;
    background: var(--accent); color: var(--surface); font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .tag svg { width: 8px; height: 10px; fill: currentColor; }
  .had { color: var(--text); font-weight: 500; }
  .ln { color: var(--muted); line-height: 22px; }
  .who { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sc, .ch { text-align: right; }
  .ch { font-size: var(--fs-small); }
  .win { color: var(--text); font-weight: 500; }
  .win .ch { color: var(--muted); font-weight: 400; }
  .upset .win .ch { color: var(--accent); font-weight: 600; }
  .nm:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
