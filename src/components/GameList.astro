---
// Final games, two lines each (away, then home): the teams, the score and each side's rating change as
// displayed, the winner in ink.
import type { Abbr, Result } from "../lib/elo.ts";
import { outcome, type Line } from "../lib/facts.ts";
import { signed } from "../lib/format.ts";
import { href } from "../lib/routes.ts";
import { team, type SeasonView } from "../lib/season.ts";

interface Props {
  season: SeasonView;
  /** The games, in the order to show them. */
  results: readonly Result[];
  /** The list's accessible name, such as "Last night's games". */
  label: string;
  /** The sentence shown when there are no games. */
  empty?: string;
}

const { season, results, label, empty = "No games yet." } = Astro.props;
const rows = results.map((r) => {
  const o = outcome(r);
  return { r, lines: [o.away, o.home] as [Line, Line] };
});
const at = (r: Result) => (r.game.neutral ? "vs" : "at");
const teamHref = (abbr: Abbr) => href({ kind: "team", season, abbr });
---

{rows.length === 0 ? (
  <p class="empty">{empty}</p>
) : (
  <div class="games" role="table" aria-label={label}>
    <div class="hds">
      {rows.slice(0, 3).map((_, i) => {
        const role = i === 0 ? "columnheader" : undefined;
        return (
          <div class="hd" role={i === 0 ? "row" : undefined} aria-hidden={i === 0 ? undefined : "true"}>
            <span role={role}>Game</span>
            <span role={role} class="r">Score</span>
            <span role={role} class="r">Change</span>
          </div>
        );
      })}
    </div>
    <div class="rows" role="rowgroup">
      {rows.map(({ r, lines }) => (
        <div class="game" role="row">
          <div class="who" role="cell">
            {lines.map((l) => (
              <span class:list={{ win: l.won }}>
                {l.side === "h" && `${at(r)} `}
                <a class="nm" href={teamHref(l.abbr)}>{team(season, l.abbr).short}</a>
              </span>
            ))}
          </div>
          <div class="n num" role="cell">
            {lines.map((l) => <span class:list={{ win: l.won }}>{l.score}</span>)}
          </div>
          <div class="n num" role="cell">
            {lines.map((l) => <span class:list={{ win: l.won }}>{signed(l.change)}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .empty { padding: 4px 0 8px; color: var(--muted); }
  .games { container-type: inline-size; --across: 1; }
  .hds, .rows { display: grid; grid-template-columns: repeat(var(--across), minmax(0, 1fr)); column-gap: var(--gap); }
  .hd, .game { display: grid; grid-template-columns: minmax(0, 1fr) 36px 48px; column-gap: 10px; }
  .hd { height: 32px; align-items: center; font-size: var(--fs-small); color: var(--muted); border-bottom: 1px solid var(--border); white-space: nowrap; }
  .hd:nth-child(n + 2) { display: none; }
  .r, .n { text-align: right; }
  .game { height: 41px; padding: 3px 0; align-items: start; }
  .game + .game { border-top: 1px solid var(--rule); }
  .game > div { display: grid; line-height: 17px; min-width: 0; color: var(--muted); }
  .game span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .game .win { color: var(--text); font-weight: 500; }
  .nm:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* A wide card sets two or three games across, read left to right. */
  @container (min-width: 680px) {
    .rows, .hds { --across: 2; }
    .hd:nth-child(2) { display: grid; }
    .game:nth-child(2) { border-top: 0; }
  }
  @container (min-width: 1040px) {
    .rows, .hds { --across: 3; }
    .hd:nth-child(3) { display: grid; }
    .game:nth-child(3) { border-top: 0; }
  }
</style>
