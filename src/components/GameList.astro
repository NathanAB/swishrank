---
// One day's final games, two lines each (away, then home): the team, the score and its rating change as
// displayed, the winner in ink.
import GameDay from "./GameDay.astro";
import { heads } from "../lib/columns.ts";
import { outcome, type Line } from "../lib/facts.ts";
import { longDay, signed, weekdayDay } from "../lib/format.ts";
import type { Day } from "../lib/results.ts";
import { href } from "../lib/routes.ts";
import { team, type SeasonView } from "../lib/season.ts";

interface Props {
  season: SeasonView;
  day: Day;
  /** Label the columns: the first day of a section does. */
  labels?: boolean;
}

const { season, day, labels = false } = Astro.props;
const games = day.results.map((r) => ({ r, lines: [outcome(r).away, outcome(r).home] as [Line, Line] }));

const notes = day.results.map((r) => r.game.note);
const meta = notes.every((n) => n !== null) && notes.length
  ? (notes.length === 1 ? notes[0].split(" - ") : [...new Set(notes.map((n) => n.split(" - ")[0]))]).join(" · ")
  : undefined;
---

<GameDay heading={weekdayDay(day.day)} meta={meta} label={`Games on ${longDay(day.day)}`} count={games.length} cols="minmax(0, 1fr) 36px 48px" labels={labels ? ["Score", "Change"] : []}>
  {games.map(({ r, lines }, i) => (
    <li class:list={["g", heads(i, games.length)]}>
      {lines.map((l) => (
        <div class:list={["ln", { win: l.won }]}>
          <span class="who">{l.side === "h" && (r.game.neutral ? "vs " : "at ")}<a class="nm" href={href({ kind: "team", season, abbr: l.abbr })}>{team(season, l.abbr).short}</a></span>
          <span class="n num">{l.score}</span>
          <span class="n num">{signed(l.change)}</span>
        </div>
      ))}
    </li>
  ))}
</GameDay>

<style>
  .ln { color: var(--muted); }
  .ln span { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .n { text-align: right; }
  .win { color: var(--text); font-weight: 500; }
  .nm:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
