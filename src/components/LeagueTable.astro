---
// The league table with the season drawn into it. A rating scale runs down the table's left edge: each team
// is a dot at its rating, joined by a curve to its row, so ties bunch and the gaps between tiers open up. On a
// wide screen the rating chart runs left of that scale and on it, so each team's line ends at its dot and the
// curve carries it on to its row, which is the line's label. The scale spans every rating of the season
// (ratingRange), so a line that ran higher or lower than today's table still fits. Rows have a fixed height,
// so every height (line ends, dots, curves, ticks) is worked out here in px of the wide screen's rows, and
// lines, curves and dots are all drawn in SVG on those px, so they meet exactly. The phone's taller rows
// stretch that drawing evenly, and the dots are round strokes that do not stretch with it. Narrower, the
// chart stacks above the table on its own axis, and the table keeps its scale. Each team's line, curve and
// dot carry a faint tint of its colour (lib/tint.ts), which goes full strength while the team is previewed;
// the rows stay ink. Given a conference, only its teams are drawn and listed, ranked among themselves, on the
// same league-wide scale, so a rating sits at the same height in every view.
import RatingChart from "./RatingChart.astro";
import { dateTicks, playoffsMark } from "../lib/chart.ts";
import { PROVISIONAL, START, provisional } from "../lib/elo.ts";
import { ratingRange } from "../lib/facts.ts";
import { rating, record } from "../lib/format.ts";
import { href } from "../lib/routes.ts";
import type { SeasonView } from "../lib/season.ts";
import { standings, type Conference } from "../lib/teams.ts";
import { tintStyles } from "../lib/tint.ts";

interface Props {
  season: SeasonView;
  /** The conference to show; leave it out for the whole league. */
  conference?: Conference;
}

const { season, conference } = Astro.props;
const m = season.model;
const { order, rank } = standings(m, conference);

const shown = Object.fromEntries(order.map((a) => [a, Math.round(m.r[a])]));
const { lo, hi } = ratingRange(m);
const n = order.length;
const tint = tintStyles(m.data.teams);
// Px down the body on a wide screen: row i's centre, and a rating's place on a scale from the first row's
// centre (the season's top rating) to the last row's (its bottom one).
const ROW = 32; // a row's height on a wide screen; the styles read it as --row-wide
const Y = n * ROW; // the body's height, and the drawing's viewBox height
const rowY = (i: number) => (i + 0.5) * ROW;
const valY = (v: number) => (hi === lo ? Y / 2 : rowY(0) + ((hi - v) / (hi - lo)) * (rowY(n - 1) - rowY(0)));
const f = (y: number) => y.toFixed(2);

// Round values to label on the scale, counted from 1500 so every gap between them is the same step. At most
// six steps across the range keeps them over 150px apart on the desktop's 960px league body.
const step = [10, 20, 25, 50, 100, 200, 250, 500].find((s) => (hi - lo) / s <= 6) ?? 500;
const marks: number[] = [];
for (let v = START - Math.floor((START - lo) / step) * step; v <= hi; v += step) marks.push(v);

// Curves and lines are drawn bottom team first, so the top team's sit on top.
const curves = order.map((a, i) => ({ a, from: valY(shown[a]), to: rowY(i) })).reverse();

// The chart, from the day before opening night on its left edge to the latest day on the scale's axis.
const ser = m.series;
const charted = ser.length >= 2;
const X = 1000; // the plot's viewBox width
const at = (i: number) => i / (ser.length - 1);
// Lines run through the displayed (rounded) ratings, as the dots do, so each one ends on its dot.
const lines = order.map((a) => ({ a, points: ser.map((d, i) => `${(at(i) * X).toFixed(1)},${f(valY(Math.round(d.r[a])))}`).join(" ") })).reverse();
const dates = dateTicks(ser.map((d) => d.day));
const playoffs = playoffsMark(m);
---

<div class:list={["lt", { charted }]} style={`--rows: ${n}; --row-wide: ${ROW}px`}>
  <div class="stacked"><RatingChart season={season} teams={order} height={400} minDayWidth={2} /></div>
  <table>
    <thead>
      <tr>
        <th class="lad" scope="col" aria-label="Rating chart">
          {charted && playoffs && <span class="mark-label" style={`--at: ${at(playoffs.i).toFixed(4)}`}>{playoffs.label}</span>}
        </th>
        <th class="num rank" scope="col"><abbr title="Rank">#</abbr></th>
        <th class="team" scope="col">Team<span class="sub"> · W–L</span></th>
        <th class="num" scope="col">Rating</th>
        <th class="num opt" scope="col">W–L</th>
      </tr>
    </thead>
    <tbody>
      {order.map((a, i) => {
        const s = m.stats[a];
        return (
          <tr data-team={a}>
            {i === 0 && (
              <td class="lad" rowspan={n} aria-hidden="true">
                <div class="lad-in">
                  {marks.map((v) => (
                    <span class="tick" style={`top: calc(${(valY(v) / ROW).toFixed(4)} * var(--row))`}>{v}</span>
                  ))}
                  {charted && (
                    <svg class="history" data-plot viewBox={`0 0 ${X} ${Y}`} preserveAspectRatio="none">
                      {marks.map((v) => <path class="grid" d={`M0,${f(valY(v))}H${X}`} />)}
                      {playoffs && <path class="marker" d={`M${(at(playoffs.i) * X).toFixed(1)},0V${Y}`} />}
                      <g>
                        {lines.map((l) => (
                          <polyline class="line" data-team={l.a} data-raise style={tint[l.a]} points={l.points} />
                        ))}
                      </g>
                    </svg>
                  )}
                  <svg class="rail" viewBox={`0 0 100 ${Y}`} preserveAspectRatio="none">
                    <path class="axis" d={`M0,${f(valY(hi))}V${f(valY(lo))}`} />
                    {curves.map((c) => (
                      <path class="lead" data-team={c.a} data-raise style={tint[c.a]} d={`M0,${f(c.from)}C50,${f(c.from)} 50,${f(c.to)} 100,${f(c.to)}`} />
                    ))}
                    <g>
                      {curves.map((c) => (
                        <g class="dot" data-team={c.a} data-preview data-raise style={tint[c.a]}>
                          <path class="ring" d={`M0,${f(c.from)}h0`} />
                          <path class="pin" d={`M0,${f(c.from)}h0`} />
                        </g>
                      ))}
                    </g>
                  </svg>
                </div>
              </td>
            )}
            <td class="num rank">{rank[a]}</td>
            <td class="team">
              <a class="go" href={href({ kind: "team", season, abbr: a })} data-team={a} data-preview><span class="name">{m.data.teams[a].short}</span></a>
              <span class="sub">{record(s.W, s.L)}</span>
            </td>
            <td class="num rating">{rating(m.r[a])}{provisional(s) && <abbr class="prov" title={`Provisional: fewer than ${PROVISIONAL} games played`}>?</abbr>}</td>
            <td class="num opt">{record(s.W, s.L)}</td>
          </tr>
        );
      })}
    </tbody>
    {charted && (
      <tfoot class="dates" aria-hidden="true">
        <tr>
          <td class="lad">
            <div class="xs">
              {dates.map((d) => (
                <span class:list={{ first: d.i === 0, last: d.i === ser.length - 1 }} style={`--at: ${at(d.i).toFixed(4)}`}>{d.text}</span>
              ))}
            </div>
          </td>
          <td colspan="4" />
        </tr>
      </tfoot>
    )}
  </table>
</div>

<style>
  /* --tl is the tick lane on the scale's left and --cv the curves' lane on its right; the axis runs between
     them, and on a wide screen the chart's plot fills the space between the two. */
  .lt { --row: var(--row-wide); --tl: 38px; --cv: 86px; }
  table { width: 100%; border-collapse: collapse; }
  th {
    height: 36px; padding: 0 8px; font-size: var(--fs-small); font-weight: 400; color: var(--muted);
    text-align: left; white-space: nowrap; border-bottom: 1px solid var(--border);
  }
  th abbr { text-decoration: none; }
  td { height: var(--row); padding: 0 8px; border-bottom: 1px solid var(--rule); white-space: nowrap; color: var(--muted); }
  tbody tr:last-child td { border-bottom: 0; }
  .num { text-align: right; }
  th:last-child, td:last-child { padding-right: 0; }
  .rank { width: 32px; }
  td.team { color: var(--text); }
  /* Each row is one link to the team's page: the name's link stretches over the row, under the scale's cell.
     Pointing at a row or focusing it previews the team on the scale and the chart. */
  tbody tr { position: relative; }
  .go::before { content: ""; position: absolute; inset: 0; z-index: 1; }
  .go:focus-visible { outline: none; }
  tr:has(.go:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
  .name { position: relative; display: inline-block; font-weight: 500; line-height: calc(var(--row) - 1px); }
  .name::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: transparent; }
  .go:hover .name { text-decoration: underline; text-underline-offset: 3px; }
  .go:hover .name::after, tr.hov .name::after { background: var(--control); }
  td.rating { position: relative; color: var(--text); font-weight: 600; }
  /* Out of flow, so a provisional rating's digits line up with the rest. */
  .prov { position: absolute; margin-left: 1px; color: var(--muted); font-weight: 400; text-decoration: none; cursor: help; }
  td.opt { color: var(--text); }
  .sub { display: none; }

  /* the scale, and the chart on it */
  .lad { width: calc(var(--tl) + var(--cv)); padding: 0; }
  th.lad { position: relative; padding-right: 8px; }
  .mark-label, .history, .dates { display: none; }
  /* Above the rows' links, so the plot takes the pointer. */
  td.lad { position: relative; z-index: 2; border-bottom: 0; }
  /* The cell starts below half of the header's collapsed 1px rule, so the drawing moves up by that half to
     sit on the rows. */
  .lad-in { position: absolute; inset: -0.5px 0 0; }
  /* Exactly the rows' height: on a wide screen one px of the drawing is one px on screen. */
  .lad svg { position: absolute; top: 0; height: calc(var(--rows) * var(--row)); overflow: visible; }
  .rail { left: calc(100% - var(--cv)); width: var(--cv); }
  .history { left: var(--tl); width: calc(100% - var(--tl) - var(--cv)); }
  .lad path, .lad polyline { fill: none; vector-effect: non-scaling-stroke; }
  .axis { stroke: var(--grid); stroke-width: 1; }
  /* Leaders only point a dot to its row, so they read as pointers, not data: grey and dotted, previewed or not. */
  .lead { stroke: var(--line-other); stroke-width: 1; stroke-dasharray: 1 3; stroke-linecap: round; }
  .grid { stroke: var(--grid); stroke-width: 1; }
  .marker { stroke: var(--muted); stroke-width: 1; }
  .line { stroke: var(--tint-rest); stroke-width: 1; stroke-linejoin: round; }
  .line.hov { stroke: var(--tint); stroke-width: 1.75; }
  .tick {
    position: absolute; right: calc(100% - var(--tl) + 8px); transform: translateY(-50%);
    font-size: 11px; line-height: 12px; color: var(--muted);
  }
  /* A dot is a round cap on a zero-length stroke, 6px across with a 1.5px ring of the surface, at any stretch. */
  .dot path { stroke-linecap: round; }
  .ring { stroke: var(--surface); stroke-width: 9; }
  .pin { stroke: var(--tint-rest); stroke-width: 6; }
  .dot.hov .pin { stroke: var(--tint); }
  /* While one team is previewed, the rest step back so its line can be followed. */
  .lt:has(.hov) :is(.line, .lead, .dot):not(.hov) { opacity: 0.4; }
  .lt:has(.hov) tbody tr:not(.hov) > td:not(.lad) { opacity: 0.4; }
  .mark-label {
    position: absolute; bottom: 2px; left: calc(var(--tl) + (100% - var(--tl) - var(--cv)) * var(--at));
    transform: translateX(calc(-100% - 4px)); font-size: 11px; line-height: 16px;
  }
  .dates td { height: 20px; padding: 0; border-bottom: 0; }
  .xs { position: relative; height: 20px; margin: 0 var(--cv) 0 var(--tl); }
  .xs span {
    position: absolute; top: 4px; left: calc(var(--at) * 100%); transform: translateX(-50%);
    font-size: var(--fs-small); line-height: 16px; color: var(--muted); white-space: nowrap;
  }
  .xs .first { transform: none; }
  .xs .last { transform: translateX(-100%); }
  .stacked { margin-bottom: 16px; }

  /* From a tablet up the scale's cell takes the width the columns leave, so no gap opens between a name and
     its figures. With the chart stacked above, that width goes to the curves. */
  @media (min-width: 641px) {
    .lad { width: 100%; }
    .lt { --cv: calc(100% - var(--tl)); }
  }
  /* From 1000px the chart sits beside the rows in that width, about 410px or more for a season's 240 days, and
     the stacked chart goes. */
  @media (min-width: 1000px) {
    .charted { --cv: 86px; }
    .charted .stacked { display: none; }
    .charted .mark-label, .charted .history { display: block; }
    .charted .dates { display: table-footer-group; }
    .charted th.lad { text-align: right; }
  }

  /* Phone: one two-line row per team, with the other figures on the second line. */
  @media (max-width: 640px) {
    .lt { --row: 48px; --tl: 28px; --cv: 18px; }
    /* The curves stop short of the rank, which sits flush against the scale on a phone. */
    .rail { width: calc(var(--cv) - 5px); }
    table { table-layout: fixed; }
    th, td { padding: 0 4px; }
    th.lad { font-size: 0; }
    th.rank { width: 22px; padding: 0 2px; }
    td.rank { padding: 0 2px; }
    th.num:not(.opt):not(.rank) { width: 76px; }
    th.num:not(.opt):not(.rank), td.rating { padding-right: 0; }
    .opt { display: none; }
    td.team { width: 100%; max-width: 0; overflow: hidden; text-overflow: ellipsis; }
    td.team, td.rating { line-height: 18px; }
    .go, .name { display: block; }
    .name { line-height: 18px; overflow: hidden; text-overflow: ellipsis; }
    .name::after { bottom: -2px; }
    .sub { display: block; color: var(--muted); font-size: 13px; line-height: 17px; font-weight: 400; overflow: hidden; text-overflow: ellipsis; }
    th .sub { display: inline; font-size: inherit; }
  }
</style>
