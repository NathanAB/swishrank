---
// One of a team's played games as a row that opens the game's page: the date, the opponent, W or L, the score
// and the rating change, and with `rating` the rating it left the team at. A win's row is in ink and a loss's
// in grey; an upset win carries the upset badge, with its rating gain in the accent. With `mirror` the row reads
// from the right on a wide screen, as the home side of a game's page does. Place it in a list item; the list
// draws the rules between rows.
import UpsetBadge from "./UpsetBadge.astro";
import { pct, rating as shown, record, shortDay, signed, weekdayDay } from "../lib/format.ts";
import { href } from "../lib/routes.ts";
import { team, type SeasonView } from "../lib/season.ts";
import { venueWord, type TeamGame } from "../lib/teams.ts";

interface Props {
  season: SeasonView;
  game: TeamGame;
  /** Show the rating the game left the team at. */
  rating?: boolean;
  mirror?: boolean;
}

const { season, game: g, rating = false, mirror = false } = Astro.props;
---

<a class:list={["row row-link", { won: g.us.won, mirror }]} href={href({ kind: "game", season, game: g.result.game })}>
  <span class:list={["in", { rated: rating }]}>
  <span class="day" title={weekdayDay(g.result.day)}>{shortDay(g.result.day)}</span>
  <span class="opp">
    <span class="nm">{venueWord(g.venue)} {team(season, g.them.abbr).short}</span>
    {g.upset && <UpsetBadge class="tag" title={`Won with a ${pct(g.us.chance)} chance`} compact />}
  </span>
  <span class="wl">{g.us.won ? "W" : "L"}</span>
  <span class="num sc">{record(g.us.score, g.them.score)}</span>
  <span class:list={["num chg", { paid: g.upset }]}>{signed(g.us.change)}</span>
  {rating && <span class="num rt">{shown(g.us.rating)}</span>}
  </span>
</a>

<style>
  /* A row lays itself out by its own width, so it fits a side column as well as a full card. */
  .row { display: block; container-type: inline-size; }
  .in { display: grid; grid-template-columns: 72px minmax(0, 1fr) 20px 96px 48px; align-items: center; column-gap: 16px; min-height: 48px; font-size: var(--fs-card); white-space: nowrap; }
  .rated { grid-template-columns: 72px minmax(0, 1fr) 20px 96px 48px 56px; }
  .won { --row-ink: var(--text); }
  .won .wl { font-weight: 600; }
  .day { color: var(--muted); }
  .num { text-align: right; }
  /* The name gives way to the badge when the row is short of room, so an upset never loses its badge. */
  .opp { display: flex; align-items: center; min-width: 0; }
  .nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .tag { margin: 0 6px; }
  /* Mirrored only where two lists stand side by side (PreviousGames.astro stacks them below 1024px). */
  @media (min-width: 1024px) {
    .mirror .in { direction: rtl; }
    .mirror .in > * { direction: ltr; text-align: right; }
    .mirror .in > .num { text-align: left; }
    .mirror .opp { justify-content: flex-end; }
  }
  @container (max-width: 459px) {
    .in { grid-template-columns: 46px minmax(0, 1fr) 14px 72px 30px; column-gap: 8px; min-height: 44px; font-size: 15px; }
    .rated { grid-template-columns: 46px minmax(0, 1fr) 14px 72px 30px 40px; }
  }
  /* In a side column the date gives way, so the opponent keeps its room. */
  @container (max-width: 299px) {
    .in, .rated { grid-template-columns: minmax(0, 1fr) 14px 72px 30px; }
    .day, .rt { display: none; }
  }
</style>
