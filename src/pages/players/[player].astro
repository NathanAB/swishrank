---
// One player's page (lib/player-page.ts): his name, his team and his headline figures, his rating over this season or
// his career, what that rating is made of, what he is worth to his team today, and his games this season. A player out
// of the league keeps his career chart and his last and best ratings. The chart is drawn in the browser at its card's
// size by scripts/player.ts; everything else is written here.
import Panel from "../../components/Panel.astro";
import Segmented from "../../components/Segmented.astro";
import Base from "../../layouts/Base.astro";
import { dayWithYear, placeLabel, record, shortDay, signed } from "../../lib/format.ts";
import { impactStrip, shown as num, waterfall, type Bar } from "../../lib/player-page.ts";
import { gameScore } from "../../lib/players.ts";
import { currentSeason, playerPaths, type PlayerPageProps } from "../../lib/season.ts";
import { href, type Route } from "../../lib/routes.ts";
import type { ChartIn } from "../../scripts/player.ts";

export function getStaticPaths() {
  return playerPaths();
}

type Props = PlayerPageProps;
const { view, teams } = Astro.props;
const route: Route = { kind: "player", id: view.id, name: view.name };
const season = currentSeason();
const W = view.worth;
const team = W ? teams[W.team] : null;
const trend = (n: number) => (n > 0 ? "up" : n < 0 ? "down" : "");
const seasonFrom = view.now ? view.seasons.at(-1)!.from : null;

const figures: { label: string; value: string; small?: string; cls?: string }[] = [
  ...(view.now
    ? [
        { label: "Rating", value: num(view.now.value) },
        { label: "Rank", value: placeLabel(view.now.rank, false), small: `of ${view.now.of}` },
        ...(view.now.change === null ? [] : [{ label: "This season", value: signed(view.now.change), cls: trend(view.now.change) }]),
      ]
    : view.last
      ? [{ label: "Last rating", value: num(view.last.value), small: dayWithYear(view.last.day) }]
      : []),
  ...(view.peak ? [{ label: "Career high", value: num(view.peak.value), small: dayWithYear(view.peak.day) }] : []),
  ...(W ? [{ label: "Minutes", value: String(Math.round(W.minutes)) }] : []),
];

const fall = view.parts ? waterfall(view.parts) : null;
const bar = (b: Bar) => `left: ${b.left.toFixed(2)}%; width: ${b.width.toFixed(2)}%`;
const impact = W && team ? impactStrip(W) : null;

const traded = new Set(view.log.map((g) => g.team)).size > 1;
const most = Math.max(0, ...view.log.map((g) => gameScore(g.line)));
const games = [...view.log].reverse().map((g) => {
  const gs = gameScore(g.line);
  return {
    ...g, gs: gs.toFixed(1), gsWidth: most > 0 ? Math.max(0, gs / most) * 56 : 0, where: g.neutral ? "vs " : g.home ? "" : "at ",
    oppShort: teams[g.opp]?.short ?? g.opp, teamShort: teams[g.team]?.short ?? g.team,
  };
});

const chart: ChartIn | null = view.series.length
  ? { name: view.name, series: view.series, stints: view.stints, seasonFrom, seasons: view.seasons, teams: Object.fromEntries(Object.entries(teams).map(([a, t]) => [a, { short: t.short, tint: t.tint }])) }
  : null;
// A rookie short of the minutes to be rated has games but no rating after any of them.
const rated = games.some((g) => g.after !== null);
const description = view.now
  ? `${view.name}${team ? ` of the ${team.name}` : ""} is rated ${num(view.now.value)}, ${placeLabel(view.now.rank, false)} of ${view.now.of} NBA players.`
  : view.peak
    ? `${view.name}'s NBA rating over his career, a high of ${num(view.peak.value)} on ${dayWithYear(view.peak.day)}.`
    : `${view.name}${team ? ` of the ${team.name}` : ""}: his games this season and what he is worth to his team.`;
---

<Base title={view.name} docTitle={`${view.name} rating`} description={description} route={route} ownHeading noindex={!W}>
  <header class="top" style={`--tint: ${team?.tint ?? "var(--line-other)"}`}>
    <div class="who">
      <p class="crumb">
        {W && team ? <a href={href({ kind: "team", season, abbr: W.team })}>{team.name}</a> : "No team"}
        {W?.out && <span class="status">Out</span>}
      </p>
      <h1>{view.name}</h1>
    </div>
    <dl class="figs" aria-label={`${view.name} in numbers`}>
      {figures.map((f) => <div><dt>{f.label}</dt><dd class:list={["num", f.cls]}>{f.value}{f.small && <small>{f.small}</small>}</dd></div>)}
    </dl>
  </header>

  <div class:list={["cols", { solo: !fall && !impact }]}>
    {chart && (
      <Panel title="Rating" class="chart-card" data-player-chart>
        {seasonFrom && (
          <div slot="aside">
            <Segmented label="Range" options={[{ label: season.label, value: "season", pressed: true }, { label: "Career", value: "career", pressed: false }]} />
          </div>
        )}
        <div class="chart" data-chart>
          <div class="tip" data-tip hidden></div>
        </div>
        <div class="sr" aria-live="polite" data-live></div>
        <p class="legend" data-legend hidden><i></i>No. 1 in the league</p>
        <script type="application/json" data-chart-data set:html={JSON.stringify(chart).replace(/</g, "\\u003c")} />
      </Panel>
    )}

    {(fall || impact) && (
      <div class="side">
        {fall && (
          <Panel title="Breakdown">
            <div class="fall">
              {fall.steps.map((s) => (
                <>
                  <span>{s.label}</span>
                  <div class="lane"><span class="zero" style={`left: ${fall.zero.toFixed(2)}%`}></span><i class:list={{ neg: s.v < 0 }} style={bar(s.bar)}></i></div>
                  <b class="num">{s.text}</b>
                </>
              ))}
              <span class="sep"></span>
              <span class="total">Rating</span>
              <div class="lane total"><span class="zero" style={`left: ${fall.zero.toFixed(2)}%`}></span><i style={bar(fall.total)}></i></div>
              <b class="num">{num(view.parts!.value)}</b>
            </div>
          </Panel>
        )}
        {impact && team && (
          <Panel title="Current impact">
            <div class="big">
              {W!.out ? <strong>Out</strong> : <strong class="num">{impact.gain}</strong>}
              <span>{W!.out ? `${team.short} ${placeLabel(impact.place, false)}` : `${team.short} ${placeLabel(impact.place, false)}, ${placeLabel(impact.placeWithout, false)} without him`}</span>
            </div>
            <div class="strip" role="img" aria-label={W!.out ? `${team.name}, without him, rated ${impact.rating}` : `${team.name} rated ${impact.rating}, ${impact.without} without him`} style={`--tint: ${team.tint}`}>
              <span class="track"></span>
              {impact.others.map((x) => <i style={`left: ${x.toFixed(2)}%`}></i>)}
              {!W!.out && (
                <>
                  <span class="gap" style={`left: ${Math.min(impact.now, impact.wo).toFixed(2)}%; width: ${Math.abs(impact.now - impact.wo).toFixed(2)}%`}></span>
                  <i class="wo" style={`left: ${impact.wo.toFixed(2)}%`}>{Math.abs(impact.now - impact.wo) > 14 && <em>{impact.without}</em>}</i>
                </>
              )}
              <i class="now" style={`left: ${impact.now.toFixed(2)}%`}><em>{impact.rating}</em></i>
            </div>
            <div class="ends"><span>30th</span><span>1st</span></div>
          </Panel>
        )}
      </div>
    )}

    {games.length > 0 && (
      <Panel title="Games" class="wide">
        <div class="scroll">
          <table class="log">
            <thead>
              <tr>
                <th scope="col">Date</th>
                {traded && <th class="l hide-sm" scope="col">For</th>}
                <th class="l" scope="col">Opponent</th>
                <th class="l" scope="col">Result</th>
                <th class:list={{ "hide-sm": rated }} scope="col">MIN</th>
                <th class:list={{ "hide-sm": rated }} scope="col">PTS</th>
                <th class="hide-sm" scope="col">FG</th>
                <th class="hide-sm" scope="col">REB</th>
                <th class="hide-sm" scope="col">AST</th>
                <th class="hide-sm" scope="col">Box score</th>
                {rated && <th scope="col">Rating</th>}
                {rated && <th scope="col">Change</th>}
              </tr>
            </thead>
            <tbody>
              {games.map((g) => (
                <tr>
                  <td>{shortDay(g.day)}</td>
                  {traded && <td class="l hide-sm">{g.teamShort}</td>}
                  <td class="l">{g.where}<span class="long">{g.oppShort}</span><span class="short">{g.opp}</span></td>
                  <td class="l res"><b>{g.us > g.them ? "W" : "L"}</b>{record(g.us, g.them)}</td>
                  <td class:list={{ "hide-sm": rated }}>{g.line[1]}</td>
                  <td class:list={{ "hide-sm": rated }}>{g.line[2]}</td>
                  <td class="hide-sm">{record(g.line[3], g.line[4])}</td>
                  <td class="hide-sm">{g.line[7] + g.line[8]}</td>
                  <td class="hide-sm">{g.line[9]}</td>
                  <td class="hide-sm"><span class="gs">{g.gs}<i style={`width: ${g.gsWidth.toFixed(1)}px`}></i></span></td>
                  {rated && <td class="rt">{g.after === null ? "–" : num(g.after)}</td>}
                  {rated && <td class={g.change === null ? "" : trend(g.change)}>{g.change === null ? "–" : signed(g.change)}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Panel>
    )}
  </div>
</Base>

<script>
  import "../../scripts/player.ts";
</script>

<style>
  /* His name and figures on the page, as a team's are (TeamHeader.astro), on a rule in his team's colour. */
  .top { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 16px 48px; padding-bottom: 16px; border-bottom: 2px solid var(--tint); }
  .crumb { margin-bottom: 4px; color: var(--muted); font-size: var(--fs-small); }
  .crumb a { color: var(--text); text-decoration: underline; text-decoration-color: var(--control); text-underline-offset: 3px; }
  .status { display: inline-block; margin-left: 8px; padding: 0 6px; border: 1px solid currentColor; border-radius: 3px; color: var(--drop); font-weight: 600; }
  h1 { font-size: clamp(34px, 3.2vw, 48px); line-height: 1.04; font-weight: 800; letter-spacing: -0.02em; }
  .figs { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px 40px; }
  dt { margin-bottom: 2px; color: var(--muted); font-size: var(--fs-small); }
  dd { font-size: 30px; line-height: 34px; font-weight: 700; letter-spacing: -0.02em; }
  dd small { margin-left: 4px; color: var(--muted); font-size: var(--fs-small); font-weight: 400; letter-spacing: 0; }
  .up { color: var(--rise); }
  .down { color: var(--drop); }

  .cols { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: var(--gap); margin-top: var(--gap); }
  .solo { grid-template-columns: minmax(0, 1fr); }
  .cols > :global(.wide) { grid-column: 1 / -1; }
  .side { display: grid; gap: var(--gap); align-content: start; }

  /* The chart fills its card's height, beside the side column, and keeps a floor of its own when the cards stack. */
  .cols > :global(.chart-card) { display: flex; flex-direction: column; }
  .cols > :global(.chart-card > .body) { flex: 1; display: flex; flex-direction: column; }
  .chart { position: relative; flex: 1; min-height: clamp(220px, 50vw, 320px); }
  .chart :global(svg) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; overflow: visible; touch-action: pan-y; border-radius: 2px; }
  .chart :global(svg:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chart :global(text) { fill: var(--muted); font: var(--fs-tiny) var(--font); }
  .chart :global(text.team) { fill: var(--text); }
  .chart :global(.grid) { stroke: var(--grid); }
  .chart :global(.zero), .chart :global(.tick) { stroke: var(--line-other); }
  .chart :global(.one) { fill: color-mix(in oklab, var(--accent) 12%, transparent); }
  .chart :global(.one-edge) { stroke: var(--accent); }
  .chart :global(.trade) { stroke: var(--muted); stroke-dasharray: 2 3; }
  .chart :global(.line path) { fill: none; stroke-width: 2; stroke-linejoin: round; }
  .chart :global(.end) { stroke: var(--surface); stroke-width: 2; }
  .chart :global(.cross) { stroke: var(--muted); }
  .chart :global(.dot) { fill: var(--text); stroke: var(--surface); stroke-width: 2; }
  .chart :global(.hit) { fill: transparent; }
  .chart .tip :global(i) { margin-left: 8px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .legend { margin-top: 10px; color: var(--muted); font-size: var(--fs-small); }
  .legend[hidden] { display: none; }
  .legend i { display: inline-block; width: 12px; height: 10px; margin-right: 6px; vertical-align: middle; background: color-mix(in oklab, var(--accent) 16%, transparent); border-top: 1px solid var(--accent); }

  /* The breakdown: a waterfall, each step starting where the last ended, the rating under them from zero. */
  .fall { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px 12px; align-items: center; color: var(--muted); font-size: var(--fs-small); }
  .fall b { color: var(--text); font-size: var(--fs-body); font-weight: 600; text-align: right; }
  .lane { position: relative; height: 10px; }
  .lane .zero { position: absolute; top: -4px; bottom: -4px; border-left: 1px solid var(--line-other); }
  .lane i { position: absolute; top: 0; bottom: 0; border-radius: 2px; background: var(--bar); }
  .lane i.neg { background: repeating-linear-gradient(135deg, var(--bar) 0 2px, transparent 2px 5px); }
  .lane.total i { background: var(--accent); }
  .fall .total { color: var(--text); }
  .sep { grid-column: 1 / -1; border-top: 1px solid var(--rule); }

  /* Current impact: the headline, then every team's rating on one line. */
  .big { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin: 4px 0 6px; }
  .big strong { font-size: 44px; line-height: 1; font-weight: 600; letter-spacing: -0.02em; }
  .big span { color: var(--muted); font-size: var(--fs-small); }
  .strip { position: relative; height: 40px; margin: 22px 0 2px; }
  .strip .track { position: absolute; left: 0; right: 0; top: 6px; border-top: 1px solid var(--border); }
  .strip i { position: absolute; top: 6px; width: 7px; height: 7px; margin: -3px 0 0 -3px; border-radius: 50%; background: #4a4a4a; }
  .strip i.now, .strip i.wo { width: 13px; height: 13px; margin: -6px 0 0 -6px; box-shadow: 0 0 0 2px var(--surface); }
  .strip i.now { background: var(--tint); }
  .strip i.wo { background: var(--surface); border: 2px solid var(--tint); }
  .strip .gap { position: absolute; top: 5px; height: 2px; background: var(--tint); opacity: 0.45; }
  .strip em { position: absolute; top: 16px; left: 50%; transform: translateX(-50%); color: var(--text); font-size: var(--fs-small); font-style: normal; font-weight: 600; white-space: nowrap; }
  .strip .wo em { color: var(--muted); font-weight: 400; }
  .ends { display: flex; justify-content: space-between; color: var(--muted); font-size: var(--fs-tiny); }

  /* The games: newest first; on a phone only the date, opponent, result, rating and its change. */
  .scroll { overflow-x: auto; margin: 0 calc(var(--card-pad) * -1); padding: 0 var(--card-pad); }
  .log { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .log th { padding: 0 10px 8px; border-bottom: 1px solid var(--rule); color: var(--muted); font-weight: 500; text-align: right; white-space: nowrap; }
  .log td { padding: 9px 10px; border-bottom: 1px solid var(--rule); text-align: right; white-space: nowrap; }
  .log :is(th, td):first-child, .log .l { padding-left: 0; text-align: left; }
  .log :is(th, td):last-child { padding-right: 0; }
  .log tr:last-child td { border-bottom: 0; }
  .log .res { color: var(--muted); }
  .log .res b { margin-right: 6px; color: var(--text); font-weight: 600; }
  .log .rt { font-size: var(--fs-body); font-weight: 600; }
  .gs { display: inline-flex; align-items: center; justify-content: flex-end; gap: 8px; }
  .gs i { display: block; height: 6px; border-radius: 0 3px 3px 0; background: var(--bar); }
  .short { display: none; }

  @media (max-width: 1000px) {
    .cols { grid-template-columns: minmax(0, 1fr); }
    .top { grid-template-columns: minmax(0, 1fr); }
    .figs { justify-content: flex-start; gap: 8px 28px; }
  }
  @media (max-width: 640px) {
    h1 { font-size: 28px; line-height: 32px; }
    dd { font-size: 22px; line-height: 26px; }
    .log th, .log td { padding-left: 6px; padding-right: 6px; }
    .hide-sm, .long { display: none; }
    .short { display: inline; }
  }
</style>
