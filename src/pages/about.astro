---
// How the ratings work, for a fan who has never heard of Elo: a three-line summary, five steps that each pair a
// sentence or two with a drawing of real games the reader can play with (components/explain/), then the fine
// print. Every figure is worked out from the season's games by lib/, so the page cannot disagree with the ratings,
// and docs/model.md to docs/model-v5.md hold the backtests behind each setting.
import DayOff from "../components/explain/DayOff.astro";
import GapAnswer from "../components/explain/GapAnswer.astro";
import GapCurve from "../components/explain/GapCurve.astro";
import Matchup from "../components/explain/Matchup.astro";
import SeasonFan from "../components/explain/SeasonFan.astro";
import WinPair from "../components/explain/WinPair.astro";
import WinValue from "../components/explain/WinValue.astro";
import Panel from "../components/Panel.astro";
import UpsetBadge from "../components/UpsetBadge.astro";
import Base from "../layouts/Base.astro";
import { EARLY, ELO_PER_SIGMA, PARAMS, START, winProb } from "../lib/elo.ts";
import { UPSET } from "../lib/facts.ts";
import { int, pct, signed, weekdayDay } from "../lib/format.ts";
import { href } from "../lib/routes.ts";
import { ABOUT_TITLE } from "../lib/meta.ts";
import { examples, offDay, upsetRatio } from "../lib/method.ts";
import { allSeasons, team } from "../lib/season.ts";

const season = allSeasons().find((s) => s.model.results.length > 0) ?? null;
const model = season?.model ?? null;
const { opener } = examples(model?.results ?? []);
const name = (abbr: string) => (season ? team(season, abbr).short : abbr);

const edge = Math.round(model?.home ?? 0);
const tired = Math.round((PARAMS.b2b * ELO_PER_SIGMA) / PARAMS.sigma);
const GAP_ANSWER = "gap-answer";

const upsetTimes = Math.round(upsetRatio(model?.results ?? []) ?? 0);
const TIMES: Record<number, string> = { 2: "twice", 3: "three times", 4: "four times", 5: "five times" };
const upsetSay = upsetTimes >= 2
  ? `An underdog's win earns about ${TIMES[upsetTimes] ?? `${upsetTimes} times`} what a favorite's does, because it was unexpected.`
  : "An underdog's win earns more than a favorite's, because it was unexpected.";

const rest = model && offDay(model.results, model.series);
const game = opener && {
  day: weekdayDay(opener.result.day),
  score: [opener.winner, opener.loser].map((s) => `${name(s.abbr)} ${s.score}`).join(", "),
  rows: [opener.winner, opener.loser].map((s) => ({
    name: name(s.abbr),
    before: Math.round(opener.result.pre[s.side]),
    after: Math.round(s.rating),
    change: s.change,
  })),
};
---

<Base
  title="How the ratings work"
  docTitle={ABOUT_TITLE}
  description="Every NBA team starts the season from its preseason odds, and every rating is worked out again after each day of games."
  route={{ kind: "about" }}
>
  <Fragment slot="lede">A rating says how strong a team is, from how it has played this season and who is playing for it.</Fragment>

  <section slot="aside" class="short" aria-labelledby="h-in-short">
    <h2 id="h-in-short">In short</h2>
    <ul>
      <li><b>Teams sit around {START}.</b> Higher is better.</li>
      <li><b>The gap sets the odds.</b> A team rated 100 points higher wins about {pct(winProb(100))} of the time.</li>
      <li><b>Wins move ratings.</b> Beating a good team, or winning big, counts more.</li>
    </ul>
  </section>

  <ol class="steps">
    <li><Panel title="Everyone starts from the preseason odds">
      <p class="say">Before opening night, each team is rated from sportsbooks' win totals, which already count the summer's trades and signings. That head start fades as the team's own games come in.</p>
      <Fragment slot="side">{season && <SeasonFan season={season} />}</Fragment>
    </Panel></li>

    <li><Panel title="The gap between two teams sets the odds">
      <p class="say">A team rated 100 points higher wins about {pct(winProb(100))} of the time, and 200 points higher about {pct(winProb(200))}. Home court is worth {int(edge)} points, so a home team is a {pct(winProb(edge))} favorite over an equal rival.</p>
      <GapAnswer id={GAP_ANSWER} />
      <Fragment slot="side"><GapCurve answer={GAP_ANSWER} /></Fragment>
    </Panel></li>

    <li><Panel title="Beating good teams, and winning big, counts more">
      <p class="say">{upsetSay} Winning big helps too, but less with each point.</p>
      {season && <WinPair season={season} />}
      <Fragment slot="side">{season && <WinValue season={season} />}</Fragment>
    </Panel></li>

    <li><Panel title="Every rating is redone each game day">
      <p class="say">Each time a team plays, its rating is worked out again from all of its games so far. Each game counts the opponent as it was rated going in, so nothing that opponent does later changes an old result. A team that doesn't play keeps its rating.</p>
      <Fragment slot="side">
        {rest ? <DayOff season={season!} /> : game && (
          <div class="game">
            <p class="day">Opening night, {game.day}</p>
            <p class="score">{game.score}</p>
            <table class="moves">
              {game.rows.map((r) => (
                <tr>
                  <th scope="row">{r.name}</th>
                  <td>{r.before}</td>
                  <td class="to">→</td>
                  <td>{r.after}</td>
                  <td class:list={["change", r.change > 0 ? "up" : "down"]}>{signed(r.change)}</td>
                </tr>
              ))}
            </table>
          </div>
        )}
      </Fragment>
    </Panel></li>

    <li><Panel title="Each game's chance, worked out">
      <p class="say">Take the home team's rating, subtract the visitor's and add home court. The curve in step 2 turns that gap into each team's chance. The game's lineup then moves it, by up to a few points, for who is likely to play that night and for how long. A team playing the second night of a back-to-back gives up another {int(tired)} points.</p>
      <Fragment slot="side">{season && <Matchup season={season} />}</Fragment>
    </Panel></li>
  </ol>

  <section class="fine" aria-labelledby="h-fine-print">
    <h2 id="h-fine-print">The fine print</h2>
    <dl class="notes">
      <dt>Scale</dt>
      <dd>Borrowed from chess's Elo ratings. Unlike Elo, which nudges a rating after each game, a team's rating here is refit to all of its games each time it plays.</dd>
      <dt>Players</dt>
      <dd>Each player has one value, built from three things. His box scores say what he did himself. The scoreline while he is on the floor, adjusted for the teammates and opponents out there with him, says how his team did with him. Both go back over past seasons. His team's results this season then move his value. A rookie has no past seasons, so his team's results move him sooner, and a top-three draft pick starts from the level such picks have played at. A team's rating counts its usual rotation, each player at his minutes over its last 10 games.</dd>
      <dt>Chances</dt>
      <dd>They follow how often past favorites won at each gap, within one percentage point of Elo's formula, 1 / (1 + 10^(−gap / 400)).</dd>
      <dt>Later games</dt>
      <dd>Each one moves a rating less, because it's one result among many.</dd>
      <dt>Early games</dt>
      <dd>Until both teams have played {EARLY.games}, the chances stay closer to 50%, because a few games say little about a team.</dd>
      <dt>Lineups</dt>
      <dd>A game's chances count each team's recent players: everyone who played in one of its last 10 games and is still with the team. Each counts for his usual minutes times his chance of playing. That chance is how often players like him have played in past seasons: players with the same status on the NBA's injury report, the latest before tip-off, who had missed as many games in a row. A player listed as out counts for almost nothing. A questionable player counts for part of his minutes, and so does a regular who sat the last game without being listed. When much of the rotation is out, the bench counts for more minutes. The minutes a team is expected to miss count a little lower, because backups play them worse than the regulars. A team the report doesn't cover yet is counted at the rates of teams with no report. Seasons before 2020–21 have no earlier injury reports to learn from, so their games count the players of each team's last game, less any the report lists as out.</dd>
      <dt>Injuries</dt>
      <dd>A team's rating leaves out players who are out for weeks. The rest of the rotation takes their minutes, counted a little lower, until the team's last 10 games show who plays them.</dd>
      <dt>Home court</dt>
      <dd>Its worth is measured each season from the three seasons before.</dd>
      <dt>Back-to-backs</dt>
      <dd>A tired team's chance drops, but its rating doesn't.</dd>
      <dt>Upsets</dt>
      <dd>A win by a team given under {UPSET}% is marked as an <UpsetBadge /></dd>
      <dt>Accuracy</dt>
      <dd><a href={href({ kind: "record" })}>The track record</a> scores every pre-game chance against how the game went.</dd>
    </dl>
  </section>
</Base>

<style>
  /* The summary and the fine print aren't steps, so neither is a filled card: the summary is an accent callout,
     and the fine print an outlined list of notes, each named on the left. Each is headed by a small label. */
  .short {
    padding: var(--card-pad); line-height: 22px; border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    background: color-mix(in srgb, var(--accent) 7%, var(--ground));
  }
  .fine { padding: var(--card-pad); border: 1px solid var(--border); border-radius: var(--radius-card); }
  .notes { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 10px 24px; line-height: 22px; }
  .notes dt { font-weight: 500; }
  .notes dd { color: var(--muted); }
  .notes a { color: var(--text); text-decoration: underline; text-decoration-color: var(--control); text-underline-offset: 3px; }
  @media (max-width: 640px) {
    .notes { grid-template-columns: minmax(0, 1fr); row-gap: 2px; }
    .notes dd + dt { margin-top: 12px; }
  }
  :is(.short, .fine) h2 {
    margin-bottom: 8px; font-size: var(--fs-small); line-height: 16px; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted);
  }
  .short h2 { color: var(--accent); }
  .short li + li { margin-top: 4px; }
  .short b { font-weight: 600; }

  /* The numbered steps, as far from the fine print below as from each other. */
  .steps { display: grid; gap: var(--gap); margin-bottom: var(--gap); counter-reset: step; }
  .steps > li { counter-increment: step; }
  /* The number as a disc beside the title, so a title that wraps keeps its lines clear of it. */
  .steps > li :global(h2) { display: flex; align-items: flex-start; gap: 10px; }
  .steps > li :global(h2)::before {
    content: counter(step); flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%;
    background: var(--accent); color: var(--ground); font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums;
  }

  .say { line-height: 22px; }
  b { color: var(--text); font-weight: 500; }

  /* Step 4, before a season has a team that rose without playing: the opener's day and score, then each team's
     rating before and after. */
  .day { font-size: var(--fs-small); line-height: 16px; color: var(--muted); margin-bottom: 4px; }
  .score { font-size: var(--fs-card); line-height: 24px; font-weight: 600; margin-bottom: 8px; }
  .moves { border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .moves th { text-align: left; font-weight: 500; padding-right: 20px; }
  .moves td { padding: 2px 0; text-align: right; }
  .moves .to { padding: 2px 8px; color: var(--muted); }
  .moves .change { padding-left: 16px; font-weight: 600; }
  .moves .up { color: var(--accent); }
  .moves .down { color: var(--muted); }
</style>
