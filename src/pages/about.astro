---
// How the ratings work, for a fan who has never heard of Elo: four steps, each one sentence and one small
// drawing of real games. Every figure comes from elo.ts, so the page cannot disagree with the ratings.
import Panel from "../components/Panel.astro";
import Base from "../layouts/Base.astro";
import { HCA, START, winProb } from "../lib/elo.ts";
import type { Line } from "../lib/facts.ts";
import { int, pct, record, shortDay, signed, weekdayDay } from "../lib/format.ts";
import { examples, type ContrastKind } from "../lib/method.ts";
import { allSeasons, team } from "../lib/season.ts";

// The newest season with a game: its opener for step 2, its results for step 3, its ratings for step 1.
const season = allSeasons().find((s) => s.model.results.length > 0) ?? null;
const model = season?.model ?? null;
const { opener, contrasts } = examples(model?.results ?? []);
const name = (abbr: string) => (season ? team(season, abbr).short : abbr);

/** A value's place on a scale from lo to hi, as a CSS percentage. */
const at = (v: number, lo: number, hi: number) => `${((v - lo) / (hi - lo)) * 100}%`;

// Step 1: every team at the start, then where each stands now, on one scale padded so no dot is cut off.
const spread = model && (() => {
  const now = model.order.map((abbr) => ({ abbr, r: Math.round(model.r[abbr]) }));
  const top = now[0];
  const bottom = now[now.length - 1];
  const pad = Math.max(4, (top.r - bottom.r) * 0.04);
  const lo = Math.min(bottom.r, START) - pad;
  const hi = Math.max(top.r, START) + pad;
  const x = (v: number) => at(v, lo, hi);
  // Dots closer than one dot's width on a phone's ~318px scale take the next lane: on the line, then
  // above it, then below, so none hides another.
  const near = ((hi - lo) * 10) / 318;
  const last: number[] = [];
  const dots = [...now].reverse().map((t) => {
    let lane = last.findIndex((r) => t.r - r >= near);
    if (lane < 0) lane = last.length;
    last[lane] = t.r;
    return { ...t, dy: [0, -10, 10, -20, 20][lane] ?? 0 };
  });
  return { dots, top, bottom, x, count: model.abbrs.length, asOf: shortDay(model.results[model.results.length - 1].day) };
})();

// Step 2: the opener on a scale centred on the start, wide enough to label each team's new rating.
const game = opener && (() => {
  const { winner: w, loser: l, result } = opener;
  const half = Math.max(Math.abs(w.change), Math.abs(l.change), 1) * 2.6;
  const x = (v: number) => at(v, START - half, START + half);
  const lane = (s: Line, verb: string) => ({
    name: name(s.abbr),
    said: `${verb} ${record(s.score, s === w ? l.score : w.score)}`,
    before: Math.round(result.pre[s.side]),
    after: Math.round(s.rating),
    change: s.change,
    won: s === w,
  });
  return { w, l, x, day: weekdayDay(result.day), lanes: [lane(w, "won"), lane(l, "lost")] };
})();

// Step 3: the three wins as bars of the winner's gain, on one scale.
const LABEL: Record<ContrastKind, (margin: number) => string> = {
  close: (m) => `Favourite wins by ${m}`,
  blowout: (m) => `Favourite wins by ${m}`,
  upset: (m) => `Underdog wins by ${m}`,
};
const most = Math.max(1, ...contrasts.map((c) => c.game.winner.change));
const bars = contrasts.map(({ kind, game: o, margin }) => ({
  label: LABEL[kind](margin),
  detail: `The ${name(o.winner.abbr)}, ${pct(o.winner.chance)} to win, beat the ${name(o.loser.abbr)} ${record(o.winner.score, o.loser.score)}.`,
  change: o.winner.change,
  width: `${(Math.max(0, o.winner.change) / most) * 82}%`,
}));

// Step 4: the favourite's chance against the rating gap, 0 to 400 points, on a 50% to 100% scale.
const GAP_MAX = 400;
const y = (p: number) => (1 - (p - 0.5) / 0.5) * 100;
const curve = Array.from({ length: GAP_MAX / 5 + 1 }, (_, i) => `${i ? "L" : "M"}${i * 5} ${y(winProb(i * 5)).toFixed(2)}`).join(" ");
const home = { x: at(HCA, 0, GAP_MAX), y: `${y(winProb(HCA))}%`, chance: pct(winProb(HCA)) };
const gapTicks = [0, 100, 200, 300, 400];
const chanceTicks = [0.5, 0.75, 1];

const methodLink = "https://web.archive.org/web/20241217142935/https://fivethirtyeight.com/features/how-we-calculate-nba-elo-ratings/";
---

<Base
  title="How the ratings work"
  description={`Every NBA team starts each season at ${START}, and each game moves points from the loser to the winner, after FiveThirtyEight's NBA Elo.`}
  route={{ kind: "about" }}
>
  <Fragment slot="lede">Elo is a rating that goes up when a team wins and down when it loses. Beating a strong team, or winning big, earns more.</Fragment>

  <div class="steps">
    <Panel title={`Everyone starts at ${START}`}>
      <p class="say">Nothing carries over from last season, so every team opens at {START} and the games spread them out.</p>
      {spread && (
        <figure
          class="spread"
          role="img"
          aria-label={`On opening night all ${spread.count} teams are at ${START}. Through ${spread.asOf} they run from ${spread.bottom.r}, the ${name(spread.bottom.abbr)}, to ${spread.top.r}, the ${name(spread.top.abbr)}.`}
        >
          <span class="mid" style={`left: ${spread.x(START)}`}></span>
          <span class="cap c1">Opening night</span>
          <span class="dot accent r1" style={`left: ${spread.x(START)}`}></span>
          <span class="tag r1" style={`left: ${spread.x(START)}`}>All {spread.count} teams at {START}</span>
          <span class="cap c2">Through {spread.asOf}</span>
          {spread.dots.map((t) => <span class="dot r2" style={`left: ${spread.x(t.r)}; translate: 0 ${t.dy}px`}></span>)}
          <span class="end lo" style={`left: ${spread.x(spread.bottom.r)}`}>{name(spread.bottom.abbr)} {spread.bottom.r}</span>
          <span class="end hi" style={`right: calc(100% - ${spread.x(spread.top.r)})`}>{name(spread.top.abbr)} {spread.top.r}</span>
        </figure>
      )}
    </Panel>

    <Panel title="Win, and you take points" meta={game?.day}>
      {game && (
        <Fragment>
          <p class="say">In the season's first game the {name(game.w.abbr)} beat the {name(game.l.abbr)} {record(game.w.score, game.l.score)} and took {game.w.change} points from them.</p>
          <figure class="game">
            <span class="mid" style={`left: ${game.x(START)}`}></span>
            <span class="mid-tag" style={`left: ${game.x(START)}`}>Both at {START} before</span>
            {game.lanes.map((s) => (
              <div class="lane">
                <p class="who"><b>{s.name}</b> {s.said}</p>
                <div class="track">
                  <span
                    class:list={["seg", { accent: s.won }]}
                    style={`left: ${game.x(Math.min(s.before, s.after))}; right: calc(100% - ${game.x(Math.max(s.before, s.after))})`}
                  ></span>
                  <span class:list={["dot", { accent: s.won }]} style={`left: ${game.x(s.after)}`}></span>
                  {s.change >= 0
                    ? <span class="val up" style={`left: ${game.x(s.after)}`}><b>{signed(s.change)}</b> to {s.after}</span>
                    : <span class="val down" style={`right: calc(100% - ${game.x(s.after)})`}><b>{signed(s.change)}</b> to {s.after}</span>}
                </div>
              </div>
            ))}
          </figure>
        </Fragment>
      )}
    </Panel>

    <Panel title="Upsets and blowouts move more">
      <p class="say">A favourite that edges a close game gains a few points, but a blowout or an upset is worth more.</p>
      {bars.length > 0 && (
        <ul class="bars">
          {bars.map((b) => (
            <li>
              <p class="who"><b>{b.label}</b></p>
              <p class="detail">{b.detail}</p>
              <div class="bar">
                <span class="fill" style={`width: ${b.width}`}></span>
                <span class="v">{signed(b.change)}</span>
              </div>
            </li>
          ))}
        </ul>
      )}
    </Panel>

    <Panel title="A bigger gap, a bigger favourite">
      <p class="say">Before tip-off, the gap between two ratings gives each team its chance to win.</p>
      <figure
        class="curve"
        role="img"
        aria-label={`A rating gap of ${int(HCA)} points gives the higher-rated team a ${home.chance} chance, and ${int(GAP_MAX)} points gives ${pct(winProb(GAP_MAX))}.`}
      >
        <p class="axis-title">Chance the higher-rated team wins</p>
        <div class="plot">
          {chanceTicks.map((p) => (
            <Fragment>
              <span class="grid" style={`top: ${y(p)}%`}></span>
              <span class="ytick" style={`top: ${y(p)}%`}>{pct(p)}</span>
            </Fragment>
          ))}
          <span class="guide v" style={`left: ${home.x}; top: ${home.y}`}></span>
          <span class="guide h" style={`width: ${home.x}; top: ${home.y}`}></span>
          <svg viewBox={`0 0 ${GAP_MAX} 100`} preserveAspectRatio="none" aria-hidden="true">
            <path d={curve} vector-effect="non-scaling-stroke" />
          </svg>
          <span class="dot accent" style={`left: ${home.x}; top: ${home.y}`}></span>
          <span class="mark" style={`left: ${home.x}; top: ${home.y}`}>{int(HCA)} points, {home.chance}</span>
          {gapTicks.map((g) => <span class="xtick" style={`left: ${at(g, 0, GAP_MAX)}`}>{int(g)}</span>)}
        </div>
        <p class="axis-title x">Rating gap, in points</p>
      </figure>
      <p class="note">Home court counts as {int(HCA)} points, so a home team facing an equal rival is a {home.chance} favourite.</p>
    </Panel>
  </div>

  <Panel class="counts" title="Which games count">
    <p class="say">Regular-season, play-in and playoff games count, but preseason games and the All-Star Game don't. Scores come from <a href="https://www.espn.com/nba/scoreboard">ESPN</a> each morning, and the method follows <a href={methodLink}>FiveThirtyEight's NBA Elo</a>.</p>
  </Panel>
</Base>

<style>
  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gap); margin-bottom: var(--gap); }
  @media (max-width: 899px) { .steps { grid-template-columns: minmax(0, 1fr); } }

  .say { max-width: 60ch; line-height: 22px; margin-bottom: 16px; }
  .say a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--control); }
  .say a:hover { text-decoration-color: currentColor; }
  .counts .say { margin-bottom: 4px; }
  .note { margin-top: 12px; color: var(--muted); }

  figure { position: relative; font-size: var(--fs-small); line-height: 16px; color: var(--muted); }
  b { color: var(--text); font-weight: 500; }

  /* A dot is 8px with a 2px ring of the card's colour, so dots that overlap stay apart. */
  .dot {
    position: absolute; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%;
    background: var(--bar); box-shadow: 0 0 0 2px var(--surface);
  }
  .dot.accent { background: var(--accent); }
  .mid { position: absolute; width: 1px; background: var(--grid); }

  /* Step 1: two rows on one scale, the start and now. */
  .spread { height: 136px; margin: 0 4px; }
  .spread .mid { top: 22px; height: 94px; }
  .spread .cap { position: absolute; left: 0; }
  .spread .c1 { top: 0; }
  .spread .c2 { top: 50px; }
  .spread .r1 { top: 30px; }
  .spread .r2 { top: 92px; }
  .spread .tag { position: absolute; margin: -8px 0 0 12px; color: var(--text); white-space: nowrap; }
  .spread .end { position: absolute; top: 120px; white-space: nowrap; }
  .spread .lo { margin-left: -4px; }
  .spread .hi { margin-right: -4px; }

  /* Step 2: one lane per team, from the shared start to the new rating. */
  .game { padding-top: 24px; }
  .game .mid { top: 18px; bottom: 0; }
  .game .mid-tag { position: absolute; top: 0; transform: translateX(-50%); white-space: nowrap; }
  .lane + .lane { margin-top: 8px; }
  .who { color: var(--muted); }
  .track { position: relative; height: 24px; }
  .seg { position: absolute; top: 11px; height: 2px; background: var(--bar); }
  .seg.accent { background: var(--accent); }
  .track .dot { top: 12px; }
  .val { position: absolute; top: 4px; white-space: nowrap; }
  .val.up { margin-left: 10px; }
  .val.down { margin-right: 10px; }

  /* Step 3: a bar per game, its length the winner's gain. */
  .bars { display: flex; flex-direction: column; gap: 14px; }
  .bars .detail { color: var(--muted); font-size: var(--fs-small); line-height: 16px; margin-top: 2px; }
  .bar { display: flex; align-items: center; gap: 8px; margin-top: 6px; height: 16px; }
  .fill { height: 12px; min-width: 2px; background: var(--accent); border-radius: 0 4px 4px 0; }
  .v { font-variant-numeric: tabular-nums; font-weight: 500; }

  /* Step 4: the curve. The svg stretches to the plot, and its 2px stroke stays 2px. */
  .curve { padding-left: 36px; padding-right: 12px; }
  .axis-title { margin: 0 0 10px -36px; }
  .axis-title.x { margin: 26px 0 0; text-align: center; }
  .plot { position: relative; height: 150px; }
  .plot svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .plot path { fill: none; stroke: var(--text); stroke-width: 2px; stroke-linejoin: round; stroke-linecap: round; }
  .grid { position: absolute; left: 0; right: 0; height: 1px; background: var(--grid); }
  .ytick { position: absolute; right: calc(100% + 8px); transform: translateY(-50%); }
  .xtick { position: absolute; top: calc(100% + 6px); transform: translateX(-50%); }
  .guide { position: absolute; background: var(--control); }
  .guide.v { width: 1px; bottom: 0; }
  .guide.h { left: 0; height: 1px; }
  .mark { position: absolute; margin: 6px 0 0 10px; color: var(--text); white-space: nowrap; }
</style>
