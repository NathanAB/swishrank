---
// How the ratings work, for a fan who has never heard of Elo: five steps, each one sentence and one small
// drawing of real games. Every figure comes from elo.ts, so the page cannot disagree with the ratings, and
// docs/model.md holds the backtest behind each setting.
import ChanceBar from "../components/ChanceBar.astro";
import Panel from "../components/Panel.astro";
import Base from "../layouts/Base.astro";
import { counted, dayKey, EARLY, gap, PARAMS, played, START, winProb } from "../lib/elo.ts";
import { UPSET, type Outcome } from "../lib/facts.ts";
import { nextDays, priced, WEEK } from "../lib/fixtures.ts";
import { int, MINUS, pct, rating, signed, weekdayDay } from "../lib/format.ts";
import { examples, offDay, type ContrastKind } from "../lib/method.ts";
import { allSeasons, team, TODAY } from "../lib/season.ts";

// The newest season with a game: its ratings for step 1, its opener and a team's day off for step 2, its results
// for step 3.
const season = allSeasons().find((s) => s.model.results.length > 0) ?? null;
const model = season?.model ?? null;
const { opener, contrasts } = examples(model?.results ?? []);
const name = (abbr: string) => (season ? team(season, abbr).short : abbr);

/** A value's place on a scale from lo to hi, as a CSS percentage. */
const at = (v: number, lo: number, hi: number) => `${((v - lo) / (hi - lo)) * 100}%`;

// Step 1: every team's daily rating, ticked at the start and one round step either side of it.
const LINES_H = 160;
const lines = model && model.series.length > 1 && (() => {
  const ser = model.series;
  const all = ser.flatMap((d) => model.abbrs.map((a) => d.r[a]));
  const reach = Math.max(...all.map((v) => Math.abs(v - START)));
  const step = [200, 100, 50, 25].find((s) => s <= reach) ?? 25;
  const lo = Math.min(START - step, ...all);
  const hi = Math.max(START + step, ...all);
  const y = (v: number) => 6 + ((LINES_H - 12) * (hi - v)) / (hi - lo);
  const x = (i: number) => (i / (ser.length - 1)) * 1000;
  const points = (a: string) => ser.map((d, i) => `${x(i).toFixed(1)},${y(d.r[a]).toFixed(1)}`).join(" ");
  const end = (abbr: string) => ({ text: `${name(abbr)} ${Math.round(model.r[abbr])}`, points: points(abbr), y: y(model.r[abbr]) });
  const top = end(model.order[0]);
  const bottom = end(model.order[model.order.length - 1]);
  // Two end labels closer than a line of text apart are pushed apart around their middle.
  const room = Math.max(0, 16 - (bottom.y - top.y)) / 2;
  const ends = [{ ...top, ly: top.y - room }, { ...bottom, ly: bottom.y + room }];
  return {
    ticks: [START + step, START, START - step].map((t) => ({ t, y: y(t) })),
    start: y(START),
    others: model.order.slice(1, -1).map(points),
    ends,
    lane: `calc(${Math.max(...ends.map((e) => e.text.length))}ch + 10px)`,
    count: model.abbrs.length,
  };
})();

// Step 2: a team that rose on a day it did not play, through a team it had beaten: its own win and that team's
// later one. Before a season has such a day, the opener's two teams, before and after.
const rest = model && offDay(model.results, model.series);
const final = (o: Outcome) =>
  `${name(o.winner.abbr)} ${o.winner.score}, ${name(o.loser.abbr)} ${o.loser.score}`;
const restShown = rest && {
  head: `${name(rest.abbr)} ${signed(rest.change)} on ${weekdayDay(rest.day)}, without playing`,
  rows: [rest.beaten, rest.win].map((o) => ({ day: weekdayDay(o.result.day), score: final(o) })),
};
const game = opener && {
  day: weekdayDay(opener.result.day),
  score: [opener.winner, opener.loser].map((s) => `${name(s.abbr)} ${s.score}`).join(", "),
  rows: [opener.winner, opener.loser].map((s) => ({
    name: name(s.abbr),
    before: Math.round(opener.result.pre[s.side]),
    after: Math.round(s.rating),
    change: s.change,
  })),
};

// Step 3: how much more a big win counts than a 1-point win, the three wins as bars of the winner's gain on one
// scale, and how many times the favourite's close win the underdog's close win earns.
const LABEL: Record<ContrastKind, (margin: number) => string> = {
  close: (m) => `Favorite wins by ${m}`,
  upset: (m) => `Underdog wins by ${m}`,
  blowout: (m) => `Favorite wins by ${m}`,
};
const blowout = contrasts.find((c) => c.kind === "blowout")?.margin ?? 43;
const blowoutTimes = (counted(blowout, PARAMS.margin) / counted(1, PARAMS.margin)).toFixed(1);
const most = Math.max(1, ...contrasts.map((c) => c.game.winner.change));
const bars = contrasts.map(({ kind, game: o, margin }) => ({
  label: LABEL[kind](margin),
  change: o.winner.change,
  width: `calc(${Math.max(0, o.winner.change) / most} * (100% - 40px))`,
}));
const gain = (kind: ContrastKind) => contrasts.find((c) => c.kind === kind)?.game.winner.change ?? 0;
const times = gain("close") > 0 ? Math.round(gain("upset") / gain("close")) : 0;
const TIMES: Record<number, string> = { 2: "twice", 3: "three times", 4: "four times", 5: "five times" };
const upsetSay = times >= 2
  ? `An underdog's close win earns about ${TIMES[times] ?? `${times} times`} what a favorite's does, because the ratings didn't expect it.`
  : "An upset or a bigger win earns more than a favorite's close win.";

// Step 4: the favourite's chance against the rating gap, 0 to 400 points, on a 50% to 100% scale, and home
// court's place on it.
const GAP_MAX = 400;
const y = (p: number) => (1 - (p - 0.5) / 0.5) * 100;
const curve = Array.from({ length: GAP_MAX / 5 + 1 }, (_, i) => `${i ? "L" : "M"}${i * 5} ${y(winProb(i * 5)).toFixed(2)}`).join(" ");
const edge = Math.round(model?.home ?? 0);
const home = { x: at(edge, 0, GAP_MAX), y: `${y(winProb(edge))}%`, chance: pct(winProb(edge)) };
const gapTicks = [0, 100, 200, 300, 400];
const chanceTicks = [0.5, 0.75, 1];

// Step 5: one game priced as the games page prices it and worked through: the first game the games page lists,
// or in a finished season its last game, as the ratings stood before tip-off.
const ahead = model && nextDays(model, TODAY, WEEK).flatMap((d) => d.fixtures)[0];
const last = model?.results.at(-1);
const shown = model && (ahead
  ? { fixture: ahead, r: model.r, played: played(model.log, ahead.game), ahead: true }
  : last && {
    fixture: priced(last.game, last.p), r: { [last.game.home]: last.pre.h, [last.game.away]: last.pre.a }, ahead: false,
    played: Math.min(...[last.game.home, last.game.away].map((a) => model.log[a].findIndex((t) => t.result === last))),
  });
const example = shown && (() => {
  const { fixture: f, r } = shown;
  const g = f.game;
  const court = g.neutral ? 0 : Math.round(model!.home);
  const sum = Math.round(r[g.home]) + court - Math.round(r[g.away]);
  return {
    fixture: f,
    ahead: shown.ahead,
    day: weekdayDay(dayKey(g.t)),
    at: g.neutral ? "vs" : "at",
    rows: [
      { label: name(g.home), value: rating(r[g.home]) },
      ...(court ? [{ label: "Home court", value: signed(court) }] : []),
      { label: name(g.away), value: `${MINUS}${rating(r[g.away])}` },
    ],
    gap: sum < 0 ? `${MINUS}${int(-sum)}` : int(sum),
    early: shown.played < EARLY.games && {
      played: shown.played,
      fav: name(f.fav === "h" ? g.home : g.away),
      later: pct(winProb(Math.abs(gap(g, r, model!.home)))),
    },
  };
})();

---

<Base
  title="How the ratings work"
  description={`Every NBA team starts each season at ${START}, the league average, and each morning the ratings are fitted again to every game so far.`}
  route={{ kind: "about" }}
>
  <Fragment slot="lede">Each rating is a number for how well a team has played this season. It uses the Elo scale from chess, where {START} is the league average and higher is better.</Fragment>

  <ol class="steps">
    <li><Panel title={`Everyone starts at ${START}`}>
      <div class="step">
        <p class="say">Rosters change too much over a summer for last season to count. The games spread the teams out from there.</p>
        {lines && (
          <figure
            class="lines"
            role="img"
            aria-label={`Every team's rating by day: all ${lines.count} start at ${START} on opening night and now run from ${lines.ends[1].text}, the lowest, to ${lines.ends[0].text}, the highest.`}
            style={`--h: ${LINES_H}px; --lane: ${lines.lane}`}
          >
            <div class="ticks">
              {lines.ticks.map((t) => <span class:list={{ ref: t.t === START }} style={`top: ${t.y}px`}>{t.t}</span>)}
            </div>
            <div class="field">
              <svg viewBox={`0 0 1000 ${LINES_H}`} preserveAspectRatio="none" aria-hidden="true">
                {lines.ticks.map((t) => <path class:list={["rule", { ref: t.t === START }]} d={`M0,${t.y}H1000`} />)}
                {lines.others.map((pts) => <polyline class="other" points={pts} />)}
                {lines.ends.map((e) => <polyline class="named" points={e.points} />)}
              </svg>
              <span class="stem" style={`top: ${lines.start}px`}></span>
              <span class="dot accent" style={`left: 0; top: ${lines.start}px`}></span>
              {lines.ends.map((e) => <span class="dot" style={`left: 100%; top: ${e.y}px`}></span>)}
            </div>
            <div class="lane">
              {lines.ends.map((e) => <span style={`top: ${e.ly}px`}>{e.text}</span>)}
            </div>
            <p class="start">Opening night, all at {START}</p>
          </figure>
        )}
      </div>
    </Panel></li>

    <li><Panel title="Every morning, every game again">
      <div class="step">
        <p class="say">Each morning every rating is worked out again from scratch, to best fit every result so far. So a win counts for more once the beaten team proves strong, and a team can rise on a day it doesn't play.</p>
        {restShown ? (
          <div class="game">
            <p class="score">{restShown.head}</p>
            <table class="moves">
              {restShown.rows.map((r) => (
                <tr>
                  <th scope="row">{r.day}</th>
                  <td class="plain">{r.score}</td>
                </tr>
              ))}
            </table>
          </div>
        ) : game && (
          <div class="game">
            <p class="day">Opening night, {game.day}</p>
            <p class="score">{game.score}</p>
            <table class="moves">
              {game.rows.map((r) => (
                <tr>
                  <th scope="row">{r.name}</th>
                  <td>{r.before}</td>
                  <td class="to">→</td>
                  <td>{r.after}</td>
                  <td class:list={["change", r.change > 0 ? "up" : "down"]}>{signed(r.change)}</td>
                </tr>
              ))}
            </table>
          </div>
        )}
      </div>
    </Panel></li>

    <li><Panel title="Bigger wins count, less and less">
      <div class="step">
        <p class="say">A {blowout}-point win counts only {blowoutTimes} times as much as a 1-point win, so a blowout padded in garbage time can't swing a rating. {upsetSay}</p>
        {bars.length > 0 && (
          <div class="bars">
            <span></span>
            <span class="head">Winner gains</span>
            {bars.map((b) => (
              <Fragment>
                <span class="label">{b.label}</span>
                <span class="bar"><span class="fill" style={`width: ${b.width}`}></span><b class="v">{signed(b.change)}</b></span>
              </Fragment>
            ))}
          </div>
        )}
      </div>
    </Panel></li>

    <li><Panel title="A bigger gap, a bigger favorite">
      <div class="step">
        <p class="say">Before tip-off, the gap between two ratings gives each team its chance to win. Home court is worth {int(edge)} points, measured over eight past seasons, so a home team is a {home.chance} favorite over an equal rival.</p>
        <figure
          class="curve"
          role="img"
          aria-label={`A rating gap of ${int(edge)} points gives the higher-rated team a ${home.chance} chance, and ${int(GAP_MAX)} points gives ${pct(winProb(GAP_MAX))}.`}
        >
          <p class="axis-title">Chance the higher-rated team wins</p>
          <div class="plot">
            {chanceTicks.map((p) => (
              <Fragment>
                <span class="grid" style={`top: ${y(p)}%`}></span>
                <span class="ytick" style={`top: ${y(p)}%`}>{pct(p)}</span>
              </Fragment>
            ))}
            <span class="guide v" style={`left: ${home.x}; top: ${home.y}`}></span>
            <span class="guide h" style={`width: ${home.x}; top: ${home.y}`}></span>
            <svg viewBox={`0 0 ${GAP_MAX} 100`} preserveAspectRatio="none" aria-hidden="true">
              <path d={curve} vector-effect="non-scaling-stroke" />
            </svg>
            <span class="dot accent" style={`left: ${home.x}; top: ${home.y}`}></span>
            <span class="mark" style={`left: ${home.x}; top: ${home.y}`}>{int(edge)} points, {home.chance}</span>
            {gapTicks.map((g) => <span class="xtick" style={`left: ${at(g, 0, GAP_MAX)}`}>{int(g)}</span>)}
          </div>
          <p class="axis-title x">Rating gap, in points</p>
        </figure>
      </div>
    </Panel></li>

    <li><Panel title="The chances on the games page">
      <div class="step">
        <div class="say">
          <p>Each game still to play gets a chance for each side. Take the home team's rating, add home court, subtract the visitor's, and read the gap off the curve above. A game days away gets the same chance it would get tonight, because ratings only move after games are played.</p>
          <p>A team's first {EARLY.games} games say little, so while either side has played fewer than that, the gap counts {EARLY.widen} times less and the chance stays closer to 50%.</p>
          <p>After the game, a winner that had under {UPSET}% is tagged as an upset.</p>
        </div>
        {example && (
          <div class="game">
            <p class="day">{example.ahead ? `Next on the games page, ${example.day}` : `The season's last game, before tip-off, ${example.day}`}</p>
            <div class="tile">
              <div class="teams">
                {example.fixture.lines.map((l) => (
                  <span class:list={{ fav: l.side === example.fixture.fav }}>{l.side === "h" && `${example.at} `}{name(l.abbr)}</span>
                ))}
              </div>
              <ChanceBar fixture={example.fixture} teams={model!.data.teams} />
            </div>
            <p class="from">Where the chances come from</p>
            <table class="moves sum">
              {example.rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  <td>{r.value}</td>
                </tr>
              ))}
              <tr class="total">
                <th scope="row">Gap, in points</th>
                <td>{example.gap}</td>
              </tr>
            </table>
            {example.early && (
              <p class="note">With {int(example.early.played)} {example.early.played === 1 ? "game" : "games"} played, under {EARLY.games}, the gap counts {EARLY.widen} times less. Later in the season it would make the {example.early.fav} {example.early.later} favorites.</p>
            )}
          </div>
        )}
      </div>
    </Panel></li>
  </ol>

</Base>

<style>
  .steps { display: grid; gap: var(--gap); }
  /* A step's words at a fixed measure beside its drawing, so every drawing starts at the same edge; stacked
     where the two do not fit side by side. */
  .step { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); align-items: start; gap: 16px 56px; padding-bottom: 8px; }
  @media (max-width: 1023px) { .step { grid-template-columns: minmax(0, 1fr); } }

  .say { line-height: 22px; }

  figure { position: relative; font-size: var(--fs-small); line-height: 16px; color: var(--muted); }
  b { color: var(--text); font-weight: 500; }

  /* A dot is 8px with a 2px ring of the card's colour, so dots that overlap stay apart. */
  .dot {
    position: absolute; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%;
    background: var(--bar); box-shadow: 0 0 0 2px var(--surface);
  }
  .dot.accent { background: var(--accent); }

  /* Step 1: a tick lane, the plot, and a lane for the two end labels. */
  .lines { max-width: 880px; display: grid; grid-template-columns: 36px minmax(0, 1fr) var(--lane); grid-template-rows: var(--h) auto; }
  .lines .ticks, .lines .field, .lines .lane { position: relative; height: var(--h); }
  .lines .ticks span { position: absolute; right: 8px; transform: translateY(-50%); }
  .lines .ticks .ref { color: var(--text); }
  .lines svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .lines path, .lines polyline { fill: none; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .lines .rule { stroke: var(--grid); stroke-width: 1; }
  .lines .rule.ref { stroke: var(--control); }
  .lines .other { stroke: var(--line-other); stroke-opacity: 0.55; stroke-width: 1; }
  .lines .named { stroke: var(--bar); stroke-width: 1.5; }
  .lines .stem { position: absolute; left: 0; bottom: 0; width: 1px; background: var(--control); }
  .lines .lane span { position: absolute; left: 10px; transform: translateY(-50%); color: var(--text); white-space: nowrap; }
  .lines .start { grid-column: 2 / 4; margin: 6px 0 0 -4px; color: var(--text); }

  /* Step 2: the day and score, then each team's rating before and after. */
  .day { font-size: var(--fs-small); line-height: 16px; color: var(--muted); margin-bottom: 4px; }
  .score { font-size: var(--fs-card); line-height: 24px; font-weight: 600; margin-bottom: 8px; }
  .moves { border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .moves th { text-align: left; font-weight: 500; padding-right: 20px; }
  .moves td { padding: 2px 0; text-align: right; }
  .moves .to { padding: 2px 8px; color: var(--muted); }
  .moves .change { padding-left: 16px; font-weight: 600; }
  .moves .up { color: var(--accent); }
  .moves .plain { text-align: left; }
  .moves .down { color: var(--muted); }

  /* Step 5: the sum down to the gap, and the early-season note. */
  .say p + p { margin-top: 12px; }
  .sum .total :is(th, td) { padding-top: 6px; border-top: 1px solid var(--rule); }
  /* The game as a tile on the games page shows it. */
  .tile { max-width: 340px; padding: 8px 12px 10px; background: var(--raised); border-radius: 4px; }
  .tile .teams { display: flex; align-items: center; justify-content: space-between; gap: 12px; line-height: 22px; color: var(--muted); }
  .tile .teams > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tile .fav { color: var(--text); font-weight: 500; }
  .from { margin: 14px 0 4px; font-size: var(--fs-small); line-height: 16px; color: var(--muted); }
  .note { margin-top: 6px; font-size: var(--fs-small); line-height: 16px; color: var(--muted); }

  /* Step 3: a bar per game, its length the winner's gain, on one scale at every screen width. */
  .bars { display: grid; grid-template-columns: max-content minmax(0, 480px); align-items: center; gap: 10px 16px; }
  .bars .head { font-size: var(--fs-small); line-height: 16px; color: var(--muted); margin-bottom: -4px; }
  .bar { display: flex; align-items: center; gap: 8px; }
  .fill { flex: none; height: 6px; min-width: 2px; background: var(--accent); border-radius: 0 3px 3px 0; }
  .v { font-variant-numeric: tabular-nums; }

  /* Step 4: the curve. The svg stretches to the plot, and its 2px stroke stays 2px. */
  .curve { max-width: 760px; padding-left: 36px; padding-right: 12px; }
  .axis-title { margin: 0 0 10px -36px; }
  .axis-title.x { margin: 26px 0 0; text-align: center; }
  .plot { position: relative; height: 150px; }
  .plot svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .plot path { fill: none; stroke: var(--text); stroke-width: 2px; stroke-linejoin: round; stroke-linecap: round; }
  .grid { position: absolute; left: 0; right: 0; height: 1px; background: var(--grid); }
  .ytick { position: absolute; right: calc(100% + 8px); transform: translateY(-50%); }
  .xtick { position: absolute; top: calc(100% + 6px); transform: translateX(-50%); }
  .guide { position: absolute; background: var(--control); }
  .guide.v { width: 1px; bottom: 0; }
  .guide.h { left: 0; height: 1px; }
  .mark { position: absolute; margin: 6px 0 0 10px; color: var(--text); white-space: nowrap; }
</style>
