---
// Every season, newest first, one row each with the team on top at its end (or now, for the season in
// progress); each row links to that season's home. It is also where the season menu leads without script.
import Panel from "../components/Panel.astro";
import Base from "../layouts/Base.astro";
import { rating } from "../lib/format.ts";
import { href } from "../lib/routes.ts";
import { allSeasons } from "../lib/season.ts";

const rows = allSeasons().map((s) => {
  const top = s.model.results.length ? s.model.order[0] : null;
  return { s, top: top && { name: s.model.data.teams[top].short, rating: rating(s.model.r[top]) } };
});
---

<Base
  title="Seasons"
  description={`Every NBA season since ${rows[rows.length - 1].s.label}, with each season's top-rated team.`}
  route={{ kind: "seasons" }}
  ownHeading
>
  <Panel level={1} class="seasons" title="Seasons">
    <table class="ruled">
      <thead>
        <tr>
          <th scope="col">Season</th>
          <th scope="col">Top team</th>
          <th scope="col" class="num">Rating</th>
          <th scope="col"><span class="sr">Status</span></th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ s, top }) => (
          <tr>
            <td><a class="go" href={href({ kind: "home", season: s })}>{s.label}</a></td>
            <td class="team">{top?.name ?? "No games yet"}</td>
            <td class="num rt">{top?.rating}</td>
            <td class="state">{s.current && "in progress"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </Panel>
</Base>

<style>
  .seasons { max-width: 760px; }
  th { height: 32px; padding: 0 12px 0 0; font-size: var(--fs-small); }
  td { height: 40px; padding: 0 12px 0 0; }
  th:last-child, td:last-child { padding-right: 0; }
  .num { text-align: right; }
  th:first-child { width: 120px; }
  .team { color: var(--text); }
  .rt { color: var(--text); font-weight: 600; }
  .state { width: 100%; padding-left: 16px; text-align: right; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  tbody tr { position: relative; }
  .go { color: var(--text); font-weight: 500; }
  .go::before { content: ""; position: absolute; inset: 0; }
  tr:hover .go { text-decoration: underline; text-underline-offset: 3px; }
  .go:focus-visible { outline: none; }
  tr:has(.go:focus-visible) { outline: 2px solid var(--accent); outline-offset: -2px; }
</style>
