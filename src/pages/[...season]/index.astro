---
// A season's home for the whole league. / is the current season and /<id>/ every other one.
import HomePage from "../../components/HomePage.astro";
import { seasonPaths, type SeasonView } from "../../lib/season.ts";

export function getStaticPaths() {
  return seasonPaths();
}

interface Props {
  season: SeasonView;
}

const { season } = Astro.props;
---

<HomePage season={season} />
