---
// A season's games, /games/ for the current season and /<id>/games/ for the rest: the week ahead and the newest month.
import GamesPage from "../../../components/GamesPage.astro";
import { seasonPaths, type SeasonView } from "../../../lib/season.ts";

export function getStaticPaths() {
  return seasonPaths();
}

interface Props {
  season: SeasonView;
}

const { season } = Astro.props;
---

<GamesPage season={season} />
