---
// One game's page, played or to come: the two teams' blocks with the score or the win chances, both teams'
// ratings through the season with the game's day marked, and each team's last five games before it.
// /games/<day>/<away>-at-<home>/ is the current season's, /<id>/games/... every other season's; a game at a
// neutral site reads <away>-vs-<home>.
import Base from "../../../../layouts/Base.astro";
import GameHeader from "../../../../components/GameHeader.astro";
import Panel from "../../../../components/Panel.astro";
import PreviousGames from "../../../../components/PreviousGames.astro";
import RatingChart from "../../../../components/RatingChart.astro";
import type { Game } from "../../../../lib/elo.ts";
import { shortDay } from "../../../../lib/format.ts";
import { gameView } from "../../../../lib/game.ts";
import { gameDescription } from "../../../../lib/meta.ts";
import type { Route } from "../../../../lib/routes.ts";
import { gamePaths, team, type SeasonView } from "../../../../lib/season.ts";
import { gamePaint } from "../../../../lib/tint.ts";

export function getStaticPaths() {
  return gamePaths();
}

interface Props {
  season: SeasonView;
  game: Game;
}

const { season, game } = Astro.props;
const route: Route = { kind: "game", season, game };
const view = gameView(season.model, game);
const [awayPaint, homePaint] = gamePaint(team(season, game.away), team(season, game.home));
const paint = { [game.away]: awayPaint, [game.home]: homePaint };
const title = `${team(season, game.away).short} ${game.neutral ? "vs" : "at"} ${team(season, game.home).short}`;
---

<Base title={title} docTitle={`${title}, ${shortDay(view.day)}, ${view.day.slice(0, 4)}`} description={gameDescription(season, view)} route={route} ownHeading>
  <div class="game">
    <GameHeader season={season} view={view} paint={paint} title={title} />
    <Panel title="Rating this season" meta="Point at the chart for any day's ratings">
      <RatingChart season={season} focus={[game.away, game.home]} paint={paint} mark={view.away.line ? { day: view.day, label: "This game" } : undefined} />
    </Panel>
    <PreviousGames season={season} view={view} paint={paint} />
  </div>
</Base>

<style>
  .game > :global(* + *) { margin-top: var(--gap); }
</style>
