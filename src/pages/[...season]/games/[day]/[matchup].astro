---
// One game's page, played or to come: the matchup and when it is, centred, over the two teams' blocks with the
// score or the win chances (TeamBlock), both teams' ratings through the season with the game's day marked, once
// it is played how each team's rating moved that day (GameBreakdown), and each team's last five games before it. /games/<day>/<away>-at-<home>/ is the current season's,
// /<id>/games/... every other season's; a game at a neutral site reads <away>-vs-<home>.
import Base from "../../../../layouts/Base.astro";
import LocalTime from "../../../../components/LocalTime.astro";
import Panel from "../../../../components/Panel.astro";
import PreviousGames from "../../../../components/PreviousGames.astro";
import RatingChart from "../../../../components/RatingChart.astro";
import TeamBlock from "../../../../components/TeamBlock.astro";
import GameBreakdown from "../../../../components/history/GameBreakdown.astro";
import type { Game } from "../../../../lib/elo.ts";
import { dayWithYear, longDay, matchup } from "../../../../lib/format.ts";
import { blockShare, gameView } from "../../../../lib/game.ts";
import { gameDescription } from "../../../../lib/meta.ts";
import type { Route } from "../../../../lib/routes.ts";
import { gamePaths, team, type SeasonView } from "../../../../lib/season.ts";
import { gamePaint } from "../../../../lib/tint.ts";

export function getStaticPaths() {
  return gamePaths();
}

interface Props {
  season: SeasonView;
  game: Game;
}

const { season, game } = Astro.props;
const route: Route = { kind: "game", season, game };
const view = gameView(season.model, game);
const [awayPaint, homePaint] = gamePaint(team(season, game.away), team(season, game.home));
const paint = { [game.away]: awayPaint, [game.home]: homePaint };
const title = matchup(team(season, game.away).short, team(season, game.home).short, game.neutral);
const meta = [view.stage.label, view.series].filter(Boolean).join(" · ");
---

<Base title={title} docTitle={`${title}, ${dayWithYear(view.day)}`} description={gameDescription(season, view)} route={route} ownHeading>
  <div class="game">
    <section aria-labelledby="h-game">
      <header class="title">
        <h1 id="h-game">{title}</h1>
        <p class="when">{longDay(view.day)} · <LocalTime at={game.t} />{meta && ` · ${meta}`}</p>
      </header>
      <div class="blocks" style={`--n: ${Math.min(blockShare(view, view.away), blockShare(view, view.home)).toFixed(3)}`}>
        <div class="pair">
          {[view.away, view.home].map((side) => <TeamBlock season={season} view={view} side={side} paint={paint[side.abbr]} />)}
        </div>
      </div>
    </section>
    <Panel title="Rating this season" meta="Point at the chart for any day's ratings">
      <RatingChart season={season} focus={[game.away, game.home]} paint={paint} mark={view.played ? { day: view.day, label: "This game" } : undefined} />
    </Panel>
    {view.played && <GameBreakdown season={season} game={game} paint={paint} />}
    <PreviousGames season={season} view={view} paint={paint} />
  </div>
</Base>

<style>
  .game > :global(* + *) { margin-top: var(--gap); }
  .title { margin-bottom: 16px; text-align: center; }
  .when { margin-top: 2px; font-size: var(--fs-card); line-height: 24px; color: var(--muted); }
  /* Both team blocks lay themselves out by the narrower one's width (TeamBlock.astro), so the row they query is
     that wide: the narrower share (--n) of the row less the 2px gap and the blocks' two 4px edges. The pair inside
     runs the row's full width again. The row holds still while the blocks grow into their shares, so neither block
     changes its layout as they do. */
  .blocks { width: calc(var(--n) * (100% - 10px)); container: blocks / inline-size; }
  .pair { display: flex; gap: 2px; width: calc(100% / var(--n) + 10px); }

  @media (max-width: 640px) {
    .when { font-size: var(--fs-body); line-height: 20px; }
  }
</style>
