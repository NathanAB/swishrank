---
// The old graph page: the chart now runs through the home page's league table.
import { href } from "../../lib/routes.ts";
import { seasonPaths, type SeasonView } from "../../lib/season.ts";

export function getStaticPaths() {
  return seasonPaths();
}

interface Props {
  season: SeasonView;
}

const { season } = Astro.props;
const home = href({ kind: "home", season });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to the ratings page</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={home} />
    <meta http-equiv="refresh" content={`0;url=${home}`} />
  </head>
  <body>
    <p>The graph is now on the <a href={home}>ratings page</a>.</p>
  </body>
</html>
