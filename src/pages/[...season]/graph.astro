---
// The old graph page: the chart now runs through the home page's league table. A meta refresh would drop the
// hash that picks a team, so a script carries it across; the link is for a browser without scripts.
import { href } from "../../lib/routes.ts";
import { seasonPaths, type SeasonView } from "../../lib/season.ts";

export function getStaticPaths() {
  return seasonPaths();
}

interface Props {
  season: SeasonView;
}

const { season } = Astro.props;
const home = href({ kind: "home", season });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to the ratings page</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={home} />
    <script is:inline define:vars={{ home }}>location.replace(home + location.hash);</script>
  </head>
  <body>
    <p>The graph is now on the <a href={home}>ratings page</a>.</p>
  </body>
</html>
