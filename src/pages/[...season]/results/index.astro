---
// The old results index, now part of the games page. Astro's config redirects drop the site base, so this
// page redirects through href(), which keeps it.
import { href } from "../../../lib/routes.ts";
import { movedSeasonPaths, type SeasonView } from "../../../lib/season.ts";

export function getStaticPaths() {
  return movedSeasonPaths();
}

interface Props {
  season: SeasonView;
}

const { season } = Astro.props;
return Astro.redirect(href({ kind: "games", season }), 301);
---
