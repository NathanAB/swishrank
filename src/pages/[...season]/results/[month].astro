---
// An old month of results, now that month's games page.
import { href } from "../../../lib/routes.ts";
import { monthPaths, type SeasonView } from "../../../lib/season.ts";

export function getStaticPaths() {
  return monthPaths();
}

interface Props {
  season: SeasonView;
  month: string;
}

const { season, month } = Astro.props;
return Astro.redirect(href({ kind: "games", season, month }));
---
