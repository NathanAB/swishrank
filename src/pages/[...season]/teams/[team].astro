---
// One team's season: its name and headline figures, how its rating moved against the other 29, the players its rating
// counts, the games it has next and every day its rating moved. /teams/<abbr>/ is the current season,
// /<id>/teams/<abbr>/ every other one. In a season under way the next five games run down a side column as the games
// page shows them, with the chart, the players heatmap and the history beside them; a finished season has nothing
// ahead, so those take the width.
import Empty from "../../../components/Empty.astro";
import FixtureList from "../../../components/FixtureList.astro";
import Heatmap from "../../../components/Heatmap.astro";
import Projections from "../../../components/Projections.astro";
import Panel from "../../../components/Panel.astro";
import RatingChart from "../../../components/RatingChart.astro";
import TeamHeader from "../../../components/TeamHeader.astro";
import History from "../../../components/history/History.astro";
import { ledger } from "../../../lib/ledger.ts";
import Base from "../../../layouts/Base.astro";
import type { Abbr } from "../../../lib/elo.ts";
import { fixtureDays } from "../../../lib/fixtures.ts";
import { teamDescription } from "../../../lib/meta.ts";
import type { Route } from "../../../lib/routes.ts";
import { TODAY, team, teamPaths, type SeasonView } from "../../../lib/season.ts";
import { nextGames, teamGames } from "../../../lib/teams.ts";
import { currentOdds } from "../../../lib/season-odds.ts";
import { teamPaint } from "../../../lib/tint.ts";

export function getStaticPaths() {
  return teamPaths();
}

interface Props {
  season: SeasonView;
  abbr: Abbr;
}

const { season, abbr } = Astro.props;
const route: Route = { kind: "team", season, abbr };
const m = season.model;
const me = team(season, abbr);
const paint = teamPaint(me);
const log = teamGames(m, abbr).reverse();
const rows = ledger(season, abbr);
const ahead = season.current ? fixtureDays(m, nextGames(m, abbr, TODAY)) : null;
const odds = season.current ? currentOdds() : null;
---

<Base
  title={me.name}
  docTitle={`${me.name} power ranking ${season.label}`}
  description={teamDescription(season, abbr)}
  route={route}
  ownHeading
>
  <TeamHeader season={season} abbr={abbr} route={route} paint={paint} />

  {odds && odds.teams[abbr] && <div class="projections"><Projections season={season} abbr={abbr} odds={odds} /></div>}

  <div class:list={["cols", { solo: !ahead }]}>
    {ahead && (
      <aside class="side">
        <Panel title="Coming up">
          {ahead.length === 0 ? (
            <Empty>No games scheduled.</Empty>
          ) : (
            <div class="days">{ahead.map((day) => <div><FixtureList season={season} day={day} /></div>)}</div>
          )}
        </Panel>
      </aside>
    )}
    <div class="main">
      <Panel title="Rating this season">
        <RatingChart season={season} focus={[abbr]} paint={{ [abbr]: paint }} />
      </Panel>
      {m.players[abbr].length > 0 && (
        <Panel title="Players">
          <Heatmap players={m.players[abbr]} label={`${me.short} players`} />
        </Panel>
      )}
      <Panel title="History">
        {rows.length === 0 ? <Empty /> : <History season={season} rows={rows} games={log} aria-label={`Rating changes for the ${me.short}, newest first`} />}
      </Panel>
    </div>
  </div>
</Base>

<style>
  /* The next games down a side column, sticking as the log scrolls past. Under 1024px everything stacks, and on
     a tablet the days of games sit side by side, as on the games page, so they don't fill the screen above the
     chart. */
  .cols { display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: var(--gap); align-items: start; margin-top: var(--gap); }
  .solo { grid-template-columns: minmax(0, 1fr); }
  .projections { margin-top: var(--gap); }
  .side { position: sticky; top: var(--gap); }
  .main > :global(* + *) { margin-top: var(--gap); }
  .days { display: grid; gap: 16px; }
  @media (max-width: 1023px) {
    .cols { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; }
    .days { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px 8px; }
  }

</style>
