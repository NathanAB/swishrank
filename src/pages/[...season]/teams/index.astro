---
// The old list of teams. The season's home has the same teams in its league table.
import { href } from "../../../lib/routes.ts";
import { movedSeasonPaths, type SeasonView } from "../../../lib/season.ts";

export function getStaticPaths() {
  return movedSeasonPaths();
}

interface Props {
  season: SeasonView;
}

const { season } = Astro.props;
return Astro.redirect(href({ kind: "home", season }), 301);
---
