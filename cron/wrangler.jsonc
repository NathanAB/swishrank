{
  "name": "nba-elo-cron",
  "account_id": "f8a103773e6ba1a5a81e5a40b3e107a7",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // 3:17 AM Eastern in winter, 4:17 AM in summer: after the latest West Coast game ends, even in overtime.
  "triggers": {
    "crons": ["17 8 * * *"]
  },
  "vars": {
    "REPO": "NathanAB/nba-elo"
  },
  // GITHUB_TOKEN is a secret: a fine-grained token for this repo with Actions read and write.
  "observability": {
    "enabled": true
  }
}
